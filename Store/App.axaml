<Application
    RequestedThemeVariant="Default"
    x:Class="Store.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:local="using:Store"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="Styles/Styles.axaml" />
        <StyleInclude Source="Styles/icon.axaml" />

        <Style Selector="NotificationCard">
            <Setter Property="Background" Value="{DynamicResource BgCard}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Width" Value="380" />
            <Setter Property="FontSize" Value="14" />

            <Style.Animations>
                <Animation Duration="0:0:0.35" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.X" Value="50" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.X" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="NotificationCard[NotificationType=Success]">
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
        </Style>
        <Style Selector="NotificationCard[NotificationType=Success] /template/ ContentControl">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="NotificationCard[NotificationType=Error]">
            <Setter Property="BorderBrush" Value="{DynamicResource DangerColor}" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
        </Style>
        <Style Selector="NotificationCard[NotificationType=Error] /template/ ContentControl">
            <Setter Property="Foreground" Value="{DynamicResource DangerColor}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="NotificationCard[NotificationType=Warning]">
            <Setter Property="BorderBrush" Value="#F59E0B" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
        </Style>
        <Style Selector="NotificationCard[NotificationType=Warning] /template/ ContentControl">
            <Setter Property="Foreground" Value="#F59E0B" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="NotificationCard[NotificationType=Information]">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderFocus}" />
            <Setter Property="BorderThickness" Value="0,0,0,0" />
        </Style>
        <Style Selector="NotificationCard[NotificationType=Information] /template/ ContentControl">
            <Setter Property="Foreground" Value="{DynamicResource BorderFocus}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgPage">#F9FAFB</SolidColorBrush>
                    <SolidColorBrush x:Key="BgCard">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgInput">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#F3F4F6</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#4B5563</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPlaceholder">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#D1D5DB</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderFocus">#667EEA</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryColor">#667EEA</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHover">#5568D3</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#EF4444</SolidColorBrush>
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgPage">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="BgCard">#1E293B</SolidColorBrush>
                    <SolidColorBrush x:Key="BgInput">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#334155</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F1F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPlaceholder">#64748B</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#334155</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderFocus">#818CF8</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryColor">#667EEA</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryHover">#818CF8</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryText">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerColor">#EF4444</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>