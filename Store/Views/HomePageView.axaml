<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Store.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" 
             d:DesignWidth="1000"
             x:DataType="vm:HomePageViewModel"
             x:Class="Store.Views.HomePageView">
    
    <Design.DataContext>
       <vm:HomePageViewModel />
    </Design.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="20" Spacing="20">
          
          <Border Classes="card" BoxShadow="0 4 20 0 #30000000">
             <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                   <GradientStop Color="#667EEA" Offset="0"/>
                   <GradientStop Color="#764BA2" Offset="1"/>
                </LinearGradientBrush>
             </Border.Background>
             <Grid ColumnDefinitions="*,Auto" Margin="10">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                   <TextBlock Text="Chào mừng trở lại! 👋"
                              FontSize="28"
                              FontWeight="Bold"
                              Foreground="White"
                              Margin="0,0,0,10"/>
                   <TextBlock Text="Hệ thống quản lý cửa hàng ShopQuality"
                              FontSize="16"
                              Foreground="#E0E0E0"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="🛍️"
                           FontSize="80"
                           VerticalAlignment="Center"/>
             </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="15">
             <Border Grid.Column="0" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <StackPanel Spacing="10">
                   <TextBlock Text="💰" FontSize="32"/>
                   <TextBlock Text="Doanh thu hôm nay" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                   <TextBlock  FontSize="22" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}">
                      <Run Text="{Binding DoanhThuHomNay}"/>
                      <Run Text=" ₫"/>
                   </TextBlock>
                   <TextBlock Text="↗ +0% so với hôm qua" FontSize="12" Foreground="{DynamicResource Success}"/>
                </StackPanel>
             </Border>

             <Border Grid.Column="1" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <StackPanel Spacing="10">
                   <TextBlock Text="📦" FontSize="32"/>
                   <TextBlock Text="Đơn hàng mới" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                   <TextBlock Text="{Binding SoHoaDon}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Success}"/>
                   <TextBlock Text="Chờ xử lý" FontSize="12" Foreground="{DynamicResource Warning}"/>
                </StackPanel>
             </Border>

             <Border Grid.Column="2" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <StackPanel Spacing="10">
                   <TextBlock Text="👻" FontSize="32"/>
                   <TextBlock Text="Khách hàng" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                   <TextBlock Text="{Binding SoKhachHang}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Info}"/>
                   <TextBlock Text="Tổng số khách" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
             </Border>

             <Border Grid.Column="3" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <StackPanel Spacing="10">
                   <TextBlock Text="📊" FontSize="32"/>
                   <TextBlock Text="Sản phẩm" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
                   <TextBlock Text="{Binding SoSanPham}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Warning}"/>
                   <TextBlock Text="Trong kho" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
             </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
    
             <Border Grid.Column="0" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                   <Grid>
                       <ItemsControl ItemsSource="{Binding HoaDons}"
                                     IsVisible="{Binding HoaDons.Count}">
                          <ItemsControl.ItemTemplate>
                             <DataTemplate>
                                <Border Classes="card" 
                                        BoxShadow="0 2 8 0 #15000000" 
                                        Margin="0 3 0 3"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1">
                                   <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                      <Border Grid.Column="0"
                                              Background="{DynamicResource BgHover}"
                                              CornerRadius="10"
                                              Width="50"
                                              Height="50"
                                              VerticalAlignment="Center"
                                              Margin="0,0,15,0">
                                         <TextBlock Text="📋" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>

                                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                         <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                            <Run>Số hóa đơn : </Run>
                                            <Run Text="{Binding SoHD}"/>
                                         </TextBlock>
                                         <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0">
                                            <Run Text=""/>
                                            <Run Text="{Binding TenKH}"/>
                                         </TextBlock>
                                      </StackPanel>

                                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                         <TextBlock Text="{Binding NgayLapHD}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right"/>
                                         <TextBlock FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" TextAlignment="Right" Margin="0,5,0,0">
                                            <Run Text="{Binding TongTienHD}"/>
                                            <Run Text=" ₫"/>
                                         </TextBlock>
                                      </StackPanel>
                                   </Grid>
                                </Border>
                             </DataTemplate>
                          </ItemsControl.ItemTemplate>
                       </ItemsControl>
                       
                       <Border Background="{DynamicResource BgHover}"
                               CornerRadius="12"
                               Padding="60,80"
                               IsVisible="{Binding !HoaDons.Count}">
                           <StackPanel HorizontalAlignment="Center" Spacing="15">
                               <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center"/>
                               <TextBlock Text="Chưa có hóa đơn nào"
                                          FontSize="18"
                                          FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextPrimary}"
                                          HorizontalAlignment="Center"/>
                           </StackPanel>
                       </Border>
                   </Grid>
                </ScrollViewer>
             </Border>

             <Border Grid.Column="1" Classes="card" BoxShadow="0 2 8 0 #20000000">
                <StackPanel>
                   <TextBlock Text="Thao tác nhanh" 
                              Classes="subheader" 
                              Foreground="{DynamicResource TextPrimary}"
                              Margin="0,0,0,15"/>
                   
                   <StackPanel Spacing="10">
                      <Button Command="{Binding TaoDonButtonCommand}" Classes="primary" HorizontalAlignment="Stretch" Padding="15">
                         <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="➕" FontSize="18"/>
                            <TextBlock Text="Tạo đơn hàng mới" FontSize="14"/>
                         </StackPanel>
                      </Button>
                      
                      <Button Command="{Binding ThemSanPhamButtonCommand}" Classes="secondary" HorizontalAlignment="Stretch" Padding="15">
                         <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📦" FontSize="18"/>
                            <TextBlock Text="Thêm sản phẩm" FontSize="14"/>
                         </StackPanel>
                      </Button>
                      
                      <Button Command="{Binding ThemKhachHangButtonCommand}" Classes="secondary" HorizontalAlignment="Stretch" Padding="15">
                         <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="👤" FontSize="18"/>
                            <TextBlock Text="Thêm khách hàng" FontSize="14"/>
                         </StackPanel>
                      </Button>
                      
                      <Button  Classes="secondary" HorizontalAlignment="Stretch" Padding="15">
                         <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="📥" FontSize="18"/>
                            <TextBlock Text="Nhập kho" FontSize="14"/>
                         </StackPanel>
                      </Button>
                   </StackPanel>
                </StackPanel>
             </Border>
          </Grid>
       </StackPanel>
    </ScrollViewer>
</UserControl>