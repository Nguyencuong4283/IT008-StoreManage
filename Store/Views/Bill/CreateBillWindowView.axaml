<Window
    Background="Transparent"
    Height="800"
    SystemDecorations="None"
    Title="CreateBillWindowView"
    TransparencyLevelHint="transparent"
    Width="700"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="800"
    d:DesignWidth="700"
    mc:Ignorable="d"
    x:Class="Store.Views.Bill.CreateBillWindowView"
    x:DataType="vm:CreateBillWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Bill"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
         ClipToBounds="True"
        CornerRadius="20">

        <Grid>
            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                HorizontalAlignment="Right"
                IsTabStop="False"
                Margin="0,5,10,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <Border
                Background="{DynamicResource BgCard}"
                BoxShadow="0 8 32 0 #20000000"
                CornerRadius="16"
                Margin="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock
                            Classes="header"
                            Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="0"
                            Margin="0,0,0,30"
                            Text="Tạo hóa đơn mới"
                            TextAlignment="Center" />

                        <Grid
                            ColumnDefinitions="*,*"
                            Grid.Row="1"
                            Margin="0,0,0,30">
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,20,0"
                                Spacing="20">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Nhân viên" />
                                    <ComboBox
                                        Classes="modern-combo"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DanhSachNhanVien, Mode=TwoWay}"
                                        PlaceholderText="Chọn nhân viên"
                                        SelectedItem="{Binding NhanVienDuocChon, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaNV_HoTen}" />

                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <Interaction.Behaviors>
                                            <FocusOnAttachedBehavior />
                                        </Interaction.Behaviors>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Khách hàng" />
                                    <ComboBox
                                        Classes="modern-combo"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DanhSachKhachHang, Mode=TwoWay}"
                                        PlaceholderText="Chọn khách hàng"
                                        SelectedItem="{Binding KhachHangDuocChon, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding MaVaTen}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Thời gian" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Text="{Binding ThoiGianHienTai}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Số hóa đơn" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Text="{Binding SoHD}" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Spacing="20">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Sản phẩm" />
                                    <ComboBox
                                        Classes="modern-combo"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DanhSachSanPham, Mode=TwoWay}"
                                        PlaceholderText="Chọn sản phẩm"
                                        SelectedItem="{Binding SanPhamDuocChon, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TenSP_Size_TonKho}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Đơn giá" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Text="{Binding GiaSP}" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*">

                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Classes="label" Text="Số lượng" />
                                        <Border
                                            Background="{DynamicResource BgInput}"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1.5"
                                            CornerRadius="8">
                                            <TextBox
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="15"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Grid.Column="0"
                                                Padding="12,10"
                                                Text="{Binding SoLuong, Mode=TwoWay}"
                                                VerticalContentAlignment="Center" />

                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Classes="label" Text="Khuyến mãi (%)" />
                                        <TextBox Classes="modern-input" Text="{Binding KhuyenMai}" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button
                                        Classes="primary"
                                        Command="{Binding ThemSanPhamCommand}"
                                        FontSize="11"
                                        Width="80">
                                        + Thêm
                                    </Button>
                                    <Button
                                        Classes="danger"
                                        Command="{Binding XoaChiTietCommand}"
                                        IsTabStop="False"
                                         FontSize="11"
                                        Width="80">
                                        🗑️ Xóa
                                    </Button>
                                    <Button
                                        Classes="primary"
                                        Command="{Binding ThanhToanCommand}"
                                        IsTabStop="False"
                                         FontSize="11"
                                        Width="110">
                                        💳 Thanh toán
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <TextBlock
                                Classes="subheader"
                                Foreground="{DynamicResource TextPrimary}"
                                Margin="0,0,0,15"
                                Text="Danh sách sản phẩm" />

                            <Border
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="15,12">
                                <Grid ColumnDefinitions="100,*,120,120,150">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="0"
                                        Text="Mã SP" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Text="Tên sản phẩm" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Text="Size" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="3"
                                        Text="Số lượng" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="4"
                                        Text="Thành tiền"
                                        TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8"
                                MaxHeight="250"
                                MinHeight="100">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChiTietHoaDons}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="15,12">
                                                    <Grid ColumnDefinitions="100,*,120,120,150">
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="0"
                                                            Text="{Binding MaSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="1"
                                                            Text="{Binding TenSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="2"
                                                            Text="{Binding KichThuocSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="3"
                                                            Text="{Binding SoLuong}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryColor}"
                                                            Grid.Column="4"
                                                            TextAlignment="Right"
                                                            VerticalAlignment="Center">
                                                            <Run Text="{Binding ThanhTien}" />
                                                            <Run Text=" ₫" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Border
                            Background="{DynamicResource BgHover}"
                            CornerRadius="12"
                            Grid.Row="3"
                            Padding="20">
                            <StackPanel Spacing="15">
                                <Grid ColumnDefinitions="*,200">
                                    <TextBlock
                                        FontSize="16"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="0"
                                        Text="Giảm giá:" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="1"
                                        Text="{Binding TongGiamGia, StringFormat='{}{0:N0} ₫'}"
                                        TextAlignment="Right" />
                                </Grid>
                                <Grid ColumnDefinitions="*,200">
                                    <TextBlock
                                        FontSize="16"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="0"
                                        Text="Tổng trị giá:" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="1"
                                        Text="{Binding TongTriGia, StringFormat='{}{0:N0} ₫'}"
                                        TextAlignment="Right" />
                                </Grid>
                                <Separator Background="{DynamicResource BorderColor}" Height="1" />
                                <Grid ColumnDefinitions="*,200">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="0"
                                        Text="Thành tiền:" />
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource PrimaryColor}"
                                        Grid.Column="1"
                                        Text="{Binding TongThanhTien, StringFormat='{}{0:N0} ₫'}"
                                        TextAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>