<Window
    Background="Transparent"
    Height="800"
    SystemDecorations="None"
    Title="Tạo phiếu nhập kho"
    Width="700"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="800"
    d:DesignWidth="700"
    mc:Ignorable="d"
    x:Class="Store.Views.CreateImportWindowView"
    x:DataType="vm:CreateImportWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Import"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
         ClipToBounds="True"
        CornerRadius="20">

        <Grid>
            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                HorizontalAlignment="Right"
                IsTabStop="False"
                Margin="0,5,10,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <Border
                Background="{DynamicResource BgCard}"
                BoxShadow="0 8 32 0 #20000000"
                CornerRadius="16"
              >
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock
                            Classes="header"
                            Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="0"
                            Margin="0,0,0,30"
                            Text="Tạo phiếu nhập kho"
                            TextAlignment="Center" />

                        <Grid
                            ColumnDefinitions="*,*"
                            Grid.Row="1"
                            Margin="0,0,0,30">
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,20,0"
                                Spacing="20">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Mã nhập kho" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Text="{Binding MaNhapKho}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Nhà cung cấp" />
                                    <TextBox
                                        Classes="modern-input"
                                        Text="{Binding NhaCungCap, Mode=TwoWay}"
                                        Watermark="Nhập tên nhà cung cấp">
                                         <Interaction.Behaviors>
                                            <FocusOnAttachedBehavior />
                                        </Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Thời gian" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        IsTabStop="False"
                                        Text="{Binding ThoiGianHienTai}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Ghi chú" />
                                    <TextBox
                                        AcceptsReturn="True"
                                        Classes="modern-input"
                                        Height="60"
                                        Text="{Binding GhiChu, Mode=TwoWay}"
                                        TextWrapping="Wrap"
                                        Watermark="Nhập ghi chú (nếu có)" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Spacing="20">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Sản phẩm" />
                                    <ComboBox
                                        Classes="modern-combo"
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding DanhSachSanPham, Mode=TwoWay}"
                                        PlaceholderText="Chọn sản phẩm"
                                        SelectedItem="{Binding SanPhamDuocChon, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TenSP}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>

                                    </ComboBox>
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Đơn giá bán" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding DonGia, Mode=TwoWay}"
                                        Watermark="Nhập đơn giá" />
                                </StackPanel>

                                 <StackPanel>
                                    <TextBlock Classes="label" Text="Đơn giá nhập" />
                                    <Border
                                Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Height="41">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Text="{Binding DonGiaNhap, Mode=TwoWay}"
                                        VerticalContentAlignment="Center" />

                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding IncreasePriceCommand}"
                                        Content="▲"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />

                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DecreasePriceCommand}"
                                        Content="▼"
                                        CornerRadius="0,8,8,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />
                                </Grid>
                            </Border>
                                </StackPanel>


                                <StackPanel>
                                    <TextBlock Classes="label" Text="Số lượng nhập" />
                                    <Border
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1.5"
                                        CornerRadius="8">
                                        <Grid ColumnDefinitions="40,*,40">
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding GiamCommand}"
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                -
                                            </Button>
                                            <TextBox
                                                Background="Transparent"
                                                BorderThickness="0"
                                                FontSize="15"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Grid.Column="1"
                                                Padding="12,10"
                                                Text="{Binding SoLuong, Mode=TwoWay}"
                                                TextAlignment="Center"
                                                VerticalContentAlignment="Center" />
                                            <Button
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding TangCommand}"
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                +
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal"
                                    Spacing="10">
                                    <Button
                                        Classes="primary"
                                        Command="{Binding ThemSanPhamCommand}"
                                         FontSize="11"
                                        Width="80">
                                        + Thêm
                                    </Button>
                                    <Button
                                        Classes="danger"
                                        Command="{Binding XoaChiTietCommand}"
                                        IsTabStop="False"
                                        FontSize="11"
                                        Width="80">
                                        🗑️ Xóa
                                    </Button>
                                    <Button
                                        Classes="primary"
                                        Command="{Binding TaoPhieuNhapCommand}"
                                        IsTabStop="False"
                                        FontSize="11"
                                        Width="110">
                                        ✓ Tạo phiếu
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <TextBlock
                                Classes="subheader"
                                Foreground="{DynamicResource TextPrimary}"
                                Margin="0,0,0,15"
                                Text="Danh sách sản phẩm nhập kho" />

                            <Border
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="15,12">
                                <Grid ColumnDefinitions="100,*,120,120,150">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="0"
                                        Text="Mã SP" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Text="Tên sản phẩm" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Text="Đơn giá" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="3"
                                        Text="Số lượng" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="4"
                                        Text="Thành tiền"
                                        TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8"
                                MaxHeight="250"
                                MinHeight="100">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChiTietList}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="15,12">
                                                    <Grid ColumnDefinitions="100,*,120,120,150">
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="0"
                                                            Text="{Binding MaSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="1"
                                                            Text="{Binding SanPham.TenSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="2"
                                                            Text="{Binding DonGia, StringFormat='{}{0:N0} ₫'}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="3"
                                                            Text="{Binding SoLuong}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryColor}"
                                                            Grid.Column="4"
                                                            Text="{Binding ThanhTien, StringFormat='{}{0:N0} ₫'}"
                                                            TextAlignment="Right"
                                                            VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Border
                            Background="{DynamicResource BgHover}"
                            CornerRadius="12"
                            Grid.Row="3"
                            Padding="20">
                            <Grid ColumnDefinitions="*,200">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Grid.Column="0"
                                    Text="Tổng tiền nhập:" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryColor}"
                                    Grid.Column="1"
                                    Text="{Binding TongTien, StringFormat='{}{0:N0} ₫'}"
                                    TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
