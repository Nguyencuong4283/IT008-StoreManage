<Window
    Background="Transparent"
    Height="600"
    SystemDecorations="None"
    Title="Tạo phiếu nhập kho"
    Width="900"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="Store.Views.CreateImportWindowView"
    x:CompileBindings="False"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
        ClipToBounds="True"
        CornerRadius="20">

        <Grid ColumnDefinitions="*,*">

            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                Margin="0,15,15,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <StackPanel
                Grid.Column="0"
                Margin="40,60"
                VerticalAlignment="Center">

                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Margin="0,0,0,30"
                    Text="Phiếu nhập kho" />

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Classes="label" Text="Mã nhập kho" />
                    <TextBox
                        Classes="modern-input"
                        IsReadOnly="True"
                        Text="{Binding}" />
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Classes="label" Text="Nhà cung cấp" />
                    <TextBox
                        Classes="modern-input"
                        Text="{Binding NhaCungCap, Mode=TwoWay}"
                        Watermark="Nhập tên nhà cung cấp" />
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Classes="label" Text="Ngày nhập" />
                    <DatePicker HorizontalAlignment="Stretch" SelectedDate="{Binding NgayNhap, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Classes="label" Text="Ghi chú" />
                    <TextBox
                        AcceptsReturn="True"
                        Classes="modern-input"
                        Height="100"
                        Text="{Binding GhiChu, Mode=TwoWay}"
                        TextWrapping="Wrap"
                        Watermark="Nhập ghi chú (nếu có)" />
                </StackPanel>
            </StackPanel>

            <Border
                Background="{DynamicResource BgCard}"
                CornerRadius="0,20,20,0"
                Grid.Column="1"
                Padding="40,60">

                <StackPanel>

                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Margin="0,0,0,20"
                        Text="Thêm sản phẩm vào phiếu" />

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Classes="label" Text="Sản phẩm" />
                        <ComboBox
                            Classes="modern-combo"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{Binding DanhSachSanPham}"
                            SelectedItem="{Binding SanPhamDangChon}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Classes="label" Text="Số lượng nhập" />
                        <TextBox Classes="modern-input" Text="{Binding SoLuongNhap, Mode=TwoWay}" />
                    </StackPanel>

                    <Button
                        Classes="secondary"
                        Command="{Binding ThemSanPhamCommand}"
                        Height="44"
                        Margin="0,0,0,30">
                        + Thêm vào danh sách
                    </Button>

                    <Button
                        Classes="primary"
                        Command="{Binding TaoPhieuNhapCommand}"
                        FontSize="16"
                        Height="52">
                        ✓ Tạo phiếu nhập kho
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
