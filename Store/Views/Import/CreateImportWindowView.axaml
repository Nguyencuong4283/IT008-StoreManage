<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="900"
        Height="600"
        Background="Transparent"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        x:CompileBindings="False"
        x:Class="Store.Views.CreateImportWindowView"
        Title="Tạo phiếu nhập kho">


    <Border CornerRadius="20"
            ClipToBounds="True"
            BoxShadow="0 10 40 5 #40000000"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="2"
            Background="{DynamicResource BgPage}">

        <Grid ColumnDefinitions="*,*">

            <Button Grid.ColumnSpan="2"
                    Command="{Binding $parent[Window].Close}"
                    Classes="close-btn"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,15,15,0"
                    ZIndex="10">
                ✕
            </Button>

            <StackPanel Grid.Column="0"
                        Margin="40,60"
                        VerticalAlignment="Center">

                <TextBlock Text="Phiếu nhập kho"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,30"/>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Mã nhập kho" Classes="label"/>
                    <TextBox Text="{Binding MaNhapKho}"
                             Classes="modern-input"
                             Watermark="Nhập mã nhập kho"
                             IsReadOnly="True"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Nhà cung cấp" Classes="label"/>
                    <TextBox Text="{Binding NhaCungCap, Mode=TwoWay}"
                             Classes="modern-input"
                             Watermark="Nhập tên nhà cung cấp"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Ngày nhập" Classes="label"/>
                    <DatePicker SelectedDate="{Binding NgayNhap, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Ghi chú" Classes="label"/>
                    <TextBox Text="{Binding GhiChu, Mode=TwoWay}"
                             Classes="modern-input"
                             Height="100"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Watermark="Nhập ghi chú (nếu có)"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="{DynamicResource BgCard}"
                    CornerRadius="0,20,20,0"
                    Padding="40,60">

                <StackPanel>

                    <TextBlock Text="Thêm sản phẩm vào phiếu"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,20"/>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Sản phẩm" Classes="label"/>
                        <ComboBox ItemsSource="{Binding DanhSachSanPham}"
                                  SelectedItem="{Binding SanPhamDangChon}"
                                  Classes="modern-combo"
                                  HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Số lượng nhập" Classes="label"/>
                        <TextBox Text="{Binding SoLuongNhap, Mode=TwoWay}"
                                 Classes="modern-input"/>
                    </StackPanel>

                    <Button Command="{Binding ThemSanPhamCommand}"
                            Classes="secondary"
                            Height="44"
                            Margin="0,0,0,30">
                        + Thêm vào danh sách
                    </Button>

                    <Button Command="{Binding TaoPhieuNhapCommand}"
                            Classes="primary"
                            Height="52"
                            FontSize="16">
                        ✓ Tạo phiếu nhập kho
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
