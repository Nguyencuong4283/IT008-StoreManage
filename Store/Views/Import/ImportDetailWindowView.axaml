<Window
    Background="Transparent"
    Height="800"
    SystemDecorations="None"
    Title="Chi tiết phiếu nhập kho"
    TransparencyLevelHint="transparent"
    Width="700"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="800"
    d:DesignWidth="700"
    mc:Ignorable="d"
    x:Class="Store.Views.Import.ImportDetailWindowView"
    x:DataType="vm:ImportDetailWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Import"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
        ClipToBounds="True"
        CornerRadius="20">

        <Grid>
            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                HorizontalAlignment="Right"
                Margin="0,5,10,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <Border
                Background="{DynamicResource BgCard}"
                BoxShadow="0 8 32 0 #20000000"
                CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="40" RowDefinitions="Auto,Auto,Auto,Auto">

                        <TextBlock
                            Classes="header"
                            Foreground="{DynamicResource TextPrimary}"
                            Grid.Row="0"
                            Margin="0,0,0,30"
                            Text="Chi tiết phiếu nhập kho"
                            TextAlignment="Center" />

                        <Grid
                            ColumnDefinitions="*,*"
                            Grid.Row="1"
                            Margin="0,0,0,30">
                            <StackPanel
                                Grid.Column="0"
                                Margin="0,0,20,0"
                                Spacing="20">
                                <StackPanel>
                                    <TextBlock Classes="label" Text="Mã nhập kho" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding MaNhapKho}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Nhà cung cấp" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding NhaCungCap}" />
                                </StackPanel>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="20,0,0,0"
                                Spacing="20">

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Ngày nhập" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding ThoiGianNhap}" />
                                </StackPanel>

                                <StackPanel>
                                    <TextBlock Classes="label" Text="Ghi chú" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding GhiChu}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" Margin="0,0,0,20">
                            <TextBlock
                                Classes="subheader"
                                Foreground="{DynamicResource TextPrimary}"
                                Margin="0,0,0,15"
                                Text="Danh sách sản phẩm nhập kho" />

                            <Border
                                Background="{DynamicResource BgHover}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0"
                                Padding="15,12">
                                <Grid ColumnDefinitions="100,*,120,120,150">
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="0"
                                        Text="Mã SP" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Text="Tên sản phẩm" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Text="Đơn giá" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="3"
                                        Text="Số lượng" />
                                    <TextBlock
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="4"
                                        Text="Thành tiền"
                                        TextAlignment="Right" />
                                </Grid>
                            </Border>

                            <Border
                                Background="{DynamicResource BgCard}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1,0,1,1"
                                CornerRadius="0,0,8,8"
                                MaxHeight="250"
                                MinHeight="100">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ChiTietNhapKho}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="15,12">
                                                    <Grid ColumnDefinitions="100,*,120,120,150">
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="0"
                                                            Text="{Binding MaSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Grid.Column="1"
                                                            Text="{Binding SanPham.TenSP}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="2"
                                                            Text="{Binding DonGia, StringFormat='{}{0:N0} ₫'}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Grid.Column="3"
                                                            Text="{Binding SoLuong}"
                                                            VerticalAlignment="Center" />
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource PrimaryColor}"
                                                            Grid.Column="4"
                                                            TextAlignment="Right"
                                                            VerticalAlignment="Center">
                                                            <Run Text="{Binding ThanhTien, StringFormat='{}{0:N0}'}" />
                                                            <Run Text=" ₫" />
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <Border
                            Background="{DynamicResource BgHover}"
                            CornerRadius="12"
                            Grid.Row="3"
                            Padding="20">
                            <Grid ColumnDefinitions="*,200">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Grid.Column="0"
                                    Text="Tổng tiền nhập:" />
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource PrimaryColor}"
                                    Grid.Column="1"
                                    Text="{Binding TongTien, StringFormat='{}{0:N0} ₫'}"
                                    TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>