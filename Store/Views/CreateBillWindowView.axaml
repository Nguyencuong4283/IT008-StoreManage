<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Store.ViewModels"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="900"
        Height="900"
        Width="900"
        Background="Transparent"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        x:Class="Store.Views.CreateBillWindowView"
        x:DataType="vm:CreateBillWindowViewModel"
        Title="CreateBillWindowView">

    <Border CornerRadius="20" 
            BoxShadow="0 10 40 5 #40000000" 
            BorderBrush="{DynamicResource BorderColor}" 
            BorderThickness="2"
            Background="{DynamicResource BgPage}">
        
       <Grid>
          <Button Command="{Binding $parent[Window].Close}"
                  Classes="close-btn"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,5,10,0"
                  ZIndex="10">
             ✕
          </Button>

          <Border Background="{DynamicResource BgCard}" 
                  CornerRadius="16" 
                  Margin="10,50,10,20" 
                  BoxShadow="0 8 32 0 #20000000">
             <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="40">
                   
                   <TextBlock Grid.Row="0"
                              Text="Tạo hóa đơn mới"
                              Classes="header"
                              Foreground="{DynamicResource TextPrimary}"
                              TextAlignment="Center"
                              Margin="0,0,0,30"/>

                   <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,0,0,30">
                      <StackPanel Grid.Column="0" Margin="0,0,20,0" Spacing="20">
                         <StackPanel>
                            <TextBlock Text="Nhân viên" Classes="label"/>
                            <ComboBox ItemsSource="{Binding DanhSachNhanVien, Mode=TwoWay}"
                                      SelectedItem="{Binding NhanVienDuocChon, Mode=TwoWay}"
                                      Classes="modern-combo"
                                      PlaceholderText="Chọn nhân viên"
                                      HorizontalAlignment="Stretch">
                                  <ComboBox.ItemTemplate>
                                     <DataTemplate>
                                        <TextBlock Text="{Binding MaNV_HoTen}"/>
                                     </DataTemplate>
                                  </ComboBox.ItemTemplate>
                               </ComboBox>
                         </StackPanel>

                         <StackPanel>
                            <TextBlock Text="Khách hàng" Classes="label"/>
                            <ComboBox ItemsSource="{Binding DanhSachKhachHang, Mode=TwoWay}"
                                      SelectedItem="{Binding KhachHangDuocChon, Mode=TwoWay}"
                                      Classes="modern-combo"
                                      PlaceholderText="Chọn khách hàng"
                                      HorizontalAlignment="Stretch">
                                  <ComboBox.ItemTemplate>
                                     <DataTemplate>
                                        <TextBlock Text="{Binding MaVaTen}"/>
                                     </DataTemplate>
                                  </ComboBox.ItemTemplate>
                               </ComboBox>
                         </StackPanel>

                         <StackPanel>
                            <TextBlock Text="Thời gian" Classes="label"/>
                            <TextBox Classes="modern-input"
                                     IsReadOnly="True"
                                     Text="{Binding ThoiGianHienTai}"/>
                         </StackPanel>

                         <StackPanel>
                            <TextBlock Text="Số hóa đơn" Classes="label"/>
                            <TextBox Classes="modern-input"
                                     Text="{Binding SoHD}"
                                     IsReadOnly="True"/>
                         </StackPanel>
                      </StackPanel>

                      <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="20">
                         <StackPanel>
                            <TextBlock Text="Sản phẩm" Classes="label"/>
                            <ComboBox ItemsSource="{Binding DanhSachSanPham, Mode=TwoWay}"
                                      SelectedItem="{Binding SanPhamDuocChon, Mode=TwoWay}"
                                      Classes="modern-combo"
                                      PlaceholderText="Chọn sản phẩm"
                                      HorizontalAlignment="Stretch">
                                  <ComboBox.ItemTemplate>
                                     <DataTemplate>
                                        <TextBlock Text="{Binding TenSP_Size_TonKho}"/>
                                     </DataTemplate>
                                  </ComboBox.ItemTemplate>
                               </ComboBox>
                         </StackPanel>

                         <StackPanel>
                            <TextBlock Text="Đơn giá" Classes="label"/>
                            <TextBox Classes="modern-input"
                                     IsReadOnly="True"
                                     Text="{Binding GiaSP}"/>
                         </StackPanel>

                         <Grid ColumnDefinitions="*,*">
                            
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                               <TextBlock Text="Số lượng" Classes="label"/>
                               <Border CornerRadius="8" 
                                       BorderBrush="{DynamicResource BorderColor}" 
                                       BorderThickness="1.5"
                                       Background="{DynamicResource BgInput}">
                                  <TextBox Grid.Column="0"
                                                   Text="{Binding SoLuong, Mode=TwoWay}"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   Padding="12,10"
                                                   VerticalContentAlignment="Center"/>
                               </Border>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                               <TextBlock Text="Khuyến mãi (%)" Classes="label"/>
                               <TextBox Classes="modern-input"
                                        Text="{Binding KhuyenMai}"/>
                            </StackPanel>
                         </Grid>

                         <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Command="{Binding ThemSanPhamCommand}" Classes="primary" Width="110">+ Thêm</Button>
                            <Button Classes="danger" Width="110">🗑️ Xóa</Button>
                            <Button Command="{Binding ThanhToanCommand}"  Classes="primary" Width="140">💳 Thanh toán</Button>
                         </StackPanel>
                      </StackPanel>
                   </Grid>

                   <StackPanel Grid.Row="2" Margin="0,0,0,20">
                      <TextBlock Text="Danh sách sản phẩm" 
                                 Classes="subheader" 
                                 Foreground="{DynamicResource TextPrimary}" 
                                 Margin="0,0,0,15"/>

                      <Border Background="{DynamicResource BgHover}"
                              BorderBrush="{DynamicResource BorderColor}"
                              BorderThickness="1"
                              CornerRadius="8,8,0,0"
                              Padding="15,12">
                         <Grid ColumnDefinitions="100,*,120,120,150">
                            <TextBlock Grid.Column="0" Text="Mã SP" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" Text="Tên sản phẩm" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="2" Text="Size" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="3" Text="Số lượng" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="4" Text="Thành tiền" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right"/>
                         </Grid>
                      </Border>

                      <Border BorderBrush="{DynamicResource BorderColor}"
                              BorderThickness="1,0,1,1"
                              CornerRadius="0,0,8,8"
                              Background="{DynamicResource BgCard}"
                              MinHeight="100"
                              MaxHeight="250">
                         <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding ChiTietHoaDons}">
                               <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                     <Border BorderBrush="{DynamicResource BorderColor}"
                                             BorderThickness="0,0,0,1"
                                             Padding="15,12">
                                        <Grid ColumnDefinitions="100,*,120,120,150">
                                           <TextBlock Grid.Column="0" Text="{Binding MaSP}" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                           <TextBlock Grid.Column="1" Text="{Binding TenSP}" FontSize="14" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                           <TextBlock Grid.Column="2" Text="{Binding KichThuocSP}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                           <TextBlock Grid.Column="3" Text="{Binding SoLuong}" FontSize="14" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                           <TextBlock Grid.Column="4" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryColor}" VerticalAlignment="Center" TextAlignment="Right">
                                              <Run Text="{Binding ThanhTien}"/>
                                              <Run Text=" ₫"/>
                                           </TextBlock>
                                        </Grid>
                                     </Border>
                                  </DataTemplate>
                               </ItemsControl.ItemTemplate>
                            </ItemsControl>
                         </ScrollViewer>
                      </Border>
                   </StackPanel>

                   <Border Grid.Row="3"
                           Background="{DynamicResource BgHover}"
                           CornerRadius="12"
                           Padding="20">
                      <StackPanel Spacing="15">
                         <Grid ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" Text="Giảm giá:" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TongGiamGia, StringFormat='{}{0:N0} ₫'}"
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       TextAlignment="Right"/>
                         </Grid>
                         <Grid ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" Text="Tổng trị giá:" FontSize="16" Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TongTriGia, StringFormat='{}{0:N0} ₫'}"
                                       FontSize="16" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource TextPrimary}" 
                                       TextAlignment="Right"/>
                         </Grid>
                         <Separator Background="{DynamicResource BorderColor}" Height="1"/>
                         <Grid ColumnDefinitions="*,200">
                            <TextBlock Grid.Column="0" Text="Thành tiền:" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding TongThanhTien, StringFormat='{}{0:N0} ₫'}"
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource PrimaryColor}" 
                                       TextAlignment="Right"/>
                         </Grid>
                      </StackPanel>
                   </Border>
                </Grid>
             </ScrollViewer>
          </Border>
       </Grid>
    </Border>
</Window>