<Window
Background="Transparent"
CanMaximize="True"
CanMinimize="True"
CanResize="True"
ExtendClientAreaToDecorationsHint="True"
Icon="/Assets/avalonia-logo.ico"
MinHeight="810"
MinWidth="1200"
SystemDecorations="None"
Title="ShopQuality - Employees"
TransparencyLevelHint="transparent"
WindowStartupLocation="CenterScreen"
d:DesignHeight="810"
d:DesignWidth="1200"
mc:Ignorable="d"
x:Class="Store.Views.Employee.EmployeeWindowView"
x:DataType="vm:EmployeeWindowViewModel"
xmlns="https://github.com/avaloniaui"
xmlns:components="clr-namespace:Store.Views.Components"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:Store.ViewModels.Employee"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Window.Styles>
		<Style Selector="Button.sidebar">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="12,10" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Left" />
			<Setter Property="Margin" Value="0,0,0,4" />
		</Style>

		<Style Selector="Button.sidebar:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
			<Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
			<Setter Property="BorderThickness" Value="2,0,0,0" />
		</Style>

		<Style Selector="Button.top-icon">
			<Setter Property="Background" Value="{DynamicResource BgInput}" />
			<Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
			<Setter Property="Width" Value="38" />
			<Setter Property="Height" Value="38" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
		</Style>
		<Style Selector="Button.top-icon:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource BgHover}" />
		</Style>
	</Window.Styles>

	<Border
	Background="{DynamicResource BgPage}"
	BoxShadow="0 10 40 5 #30000000"
	ClipToBounds="True"
	CornerRadius="16">

		<Grid ColumnDefinitions="240,*" RowDefinitions="80,*">
			<Border
			BoxShadow="0 2 8 0 #15000000"
			Grid.Column="0"
			Grid.ColumnSpan="2"
			PointerPressed="Header_PointerPressed">
				<Border.Background>
					<LinearGradientBrush EndPoint="100%,0%" StartPoint="0%,0%">
						<GradientStop Color="#667EEA" Offset="0" />
						<GradientStop Color="#764BA2" Offset="1" />
					</LinearGradientBrush>
				</Border.Background>

				<Grid ColumnDefinitions="240,*,Auto" Margin="20,0">
					<Grid RowDefinitions="15,*">
						<StackPanel Margin="0,15,0,0" Orientation="Horizontal">
							<Button Classes="MacBtn CloseBtn" Click="CloseBtn" />
							<Button Classes="MacBtn MinBtn" Click="MinimizeBtn" />
							<Button Classes="MacBtn MaxBtn" Click="MaximizeBtn" />
						</StackPanel>

						<StackPanel
						Grid.Row="1"
						Orientation="Horizontal"
						Spacing="10"
						VerticalAlignment="Center">
							<TextBlock FontSize="28" Text="🛍️" />
							<TextBlock
							FontSize="20"
							FontWeight="Bold"
							Foreground="White"
							Text="ShopQuality"
							VerticalAlignment="Center" />
						</StackPanel>
					</Grid>

					<Border
					Grid.Column="1"
					Height="42"
					Margin="20,0"
					MaxWidth="500" />

				</Grid>
			</Border>

			<Border
			Background="{DynamicResource BgCard}"
			BorderBrush="{DynamicResource BorderColor}"
			BorderThickness="0,0,1,0"
			Grid.Column="0"
			Grid.Row="1">

				<Grid RowDefinitions="*,Auto">
					<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
						<StackPanel Margin="12" Spacing="4">

							<Button Classes="sidebar" Command="{Binding GoHomeCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="🏠"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Tổng quan"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Classes="sidebar" Command="{Binding GoBillCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="📋"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Đơn hàng"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Classes="sidebar" Command="{Binding GoProductCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="📦"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Sản phẩm"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Classes="sidebar" Command="{Binding GoCustomerCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="👻"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Khách hàng"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Classes="sidebar" Command="{Binding GoHistoryCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="📥"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Nhập kho"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>

							<Button Classes="sidebar" Command="{Binding GoAccountSettingCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="👤"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Tài khoản"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>


						</StackPanel>
					</ScrollViewer>

					<Border
					BorderBrush="{DynamicResource BorderColor}"
					BorderThickness="0,1,0,0"
					Grid.Row="1"
					Padding="12">
						<StackPanel>
							<Button
							Classes="sidebar"
							Click="LogoutButton_Click">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="🚪"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Đăng xuất"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>
							<Button Classes="sidebar" Command="{Binding GoSettingCommand}">
								<StackPanel Orientation="Horizontal" Spacing="10">
									<TextBlock
									FontSize="18"
									Text="⚙️"
									VerticalAlignment="Center" />
									<TextBlock
									FontSize="14"
									Text="Cài đặt"
									VerticalAlignment="Center" />
								</StackPanel>
							</Button>
						</StackPanel>
					</Border>
				</Grid>
			</Border>

			<Border
			Background="{DynamicResource BgPage}"
			Grid.Column="1"
			Grid.Row="1"
			Padding="20">
				<ContentControl Content="{Binding CurrentPage}" />
			</Border>

		</Grid>
	</Border>
</Window>