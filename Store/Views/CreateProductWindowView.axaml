<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Store.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000"
        d:DesignHeight="700"
        Height="700"
        Width="1000"
        Background="Transparent"
        SystemDecorations="None"
        x:DataType="vm:CreateProductWindowViewModel"
        WindowStartupLocation="CenterScreen"
        x:Class="Store.CreateProductWindowView"
        Title="Create Product">

    <Border CornerRadius="20" 
            ClipToBounds="True" 
            BoxShadow="0 10 40 5 #40000000" 
            BorderBrush="{DynamicResource BorderColor}" 
            BorderThickness="2"
            Background="{DynamicResource BgPage}">
       
       <Grid ColumnDefinitions="420,*">
          <Button Grid.Column="1"
                  Command="{Binding $parent[Window].Close}"
                  Classes="close-btn"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Top"
                  Margin="0,15,15,0"
                  ZIndex="10">
             ✕
          </Button>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="40,60">
             <TextBlock FontSize="28"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        TextAlignment="Center"
                        Margin="0,0,0,30">
                Sản phẩm mới
             </TextBlock>

             <Border Background="{DynamicResource BgInput}"
                     CornerRadius="16"
                     BoxShadow="0 4 16 0 #20000000"
                     Width="340"
                     Height="340"
                     ClipToBounds="True"
                     Margin="0,0,0,20">
                <Image Source="{Binding HinhAnhSP}" Stretch="UniformToFill"/>
             </Border>

             <Button Command="{Binding ThemAnhButtonCommand}"
                     Width="340"
                     Classes="primary"
                     Height="48"
                     FontSize="15"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center">
                📷 Chọn hình ảnh
             </Button>
          </StackPanel>

          <Border Grid.Column="1" 
                  Background="{DynamicResource BgCard}" 
                  CornerRadius="0,20,20,0" 
                  Padding="40,60">
          
                <StackPanel>
                   <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                         <TextBlock Text="Mã sản phẩm" Classes="label"/>
                         <TextBox Text="{Binding MaSP}"
                                  Classes="modern-input"
                                  IsReadOnly="True"/>
                      </StackPanel>
                      
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                         <TextBlock Text="Tên sản phẩm" Classes="label"/>
                         <TextBox Text="{Binding TenSP, Mode=TwoWay}"
                                  Classes="modern-input"
                                  Watermark="Nhập tên sản phẩm"/>
                      </StackPanel>
                   </Grid>

                   <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                      
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                         <TextBlock Text="Giá sản phẩm (VND)" Classes="label"/>
                         
                         <Border CornerRadius="8" 
                                 Height="41"
                                 BorderBrush="{DynamicResource BorderColor}" 
                                 BorderThickness="1.5" 
                                 Background="{DynamicResource BgInput}">
                            <Grid ColumnDefinitions="*,Auto,Auto" >
                               <TextBox Grid.Column="0"
                                        Text="{Binding GiaSP, Mode=TwoWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Padding="12,10"
                                        VerticalContentAlignment="Center"/>
                               
                               <Button Grid.Column="1"
                                       Content="▲"
                                       Width="35"
                                       Height="48"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondary}"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Cursor="Hand"
                                       Command="{Binding TangGiaCommand}"
                                       VerticalContentAlignment="Center"/>
                               
                               <Button Grid.Column="2"
                                       Content="▼"
                                       Width="35"
                                       Height="48"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondary}"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Cursor="Hand"
                                       CornerRadius="0,8,8,0"
                                       Command="{Binding GiamGiaCommand}"
                                       VerticalContentAlignment="Center"/>
                            </Grid>
                         </Border>
                      </StackPanel>
                      
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                         <TextBlock Text="Loại sản phẩm" Classes="label"/>
                         <ComboBox ItemsSource="{Binding DanhSachLoaiSP}"
                                   SelectedItem="{Binding LoaiSP, Mode=TwoWay}"
                                   Classes="modern-combo"
                                   PlaceholderText="Chọn loại"
                                   Width="235"
                                   HorizontalAlignment="Stretch"/>
                      </StackPanel>
                   </Grid>

                   <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                      
                      <StackPanel Grid.Column="0" Margin="0,0,10,0">
                         <TextBlock Text="Số lượng" Classes="label"/>
                         <Border CornerRadius="8" 
                                 Height="41"
                                 BorderBrush="{DynamicResource BorderColor}" 
                                 BorderThickness="1.5" 
                                 Background="{DynamicResource BgInput}">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                               <TextBox Grid.Column="0"
                                        Text="{Binding SoLuongSP, Mode=TwoWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Padding="12,10"
                                        VerticalContentAlignment="Center"/>
                               <Button Grid.Column="1"
                                       Content="▲"
                                       Width="35"
                                       Height="48"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondary}"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Cursor="Hand"
                                       Command="{Binding TangSoLuongCommand}"
                                       VerticalContentAlignment="Center"/>
                               <Button Grid.Column="2"
                                       Content="▼"
                                       Width="35"
                                       Height="48"
                                       Background="Transparent"
                                       Foreground="{DynamicResource TextSecondary}"
                                       BorderThickness="0"
                                       FontSize="12"
                                       Cursor="Hand"
                                       CornerRadius="0,8,8,0"
                                       Command="{Binding GiamSoLuongCommand}"
                                       VerticalContentAlignment="Center"/>
                            </Grid>
                         </Border>
                      </StackPanel>
                      
                      <StackPanel Grid.Column="1" Margin="10,0,0,0">
                         <TextBlock Text="Kích cỡ" Classes="label"/>
                         <ComboBox ItemsSource="{Binding DanhSachKichThuocSP}"
                                   SelectedItem="{Binding KichThuocSP, Mode=TwoWay}"
                                   Classes="modern-combo"
                                   PlaceholderText="FreeSize"
                                   Width="235"
                                   HorizontalAlignment="Stretch"/>
                      </StackPanel>
                   </Grid>

                   <StackPanel Margin="0,0,0,30">
                      <TextBlock Text="Thông tin sản phẩm" Classes="label"/>
                      <TextBox Text="{Binding MoTaSP, Mode=TwoWay}"
                               Classes="modern-input"
                               Height="140"
                               AcceptsReturn="True"
                               TextWrapping="Wrap"
                               Watermark="Nhập mô tả chi tiết về sản phẩm..."
                               VerticalContentAlignment="Top"/>
                   </StackPanel>

                   <Button Command="{Binding TaoSanPhamCommand}"
                           Classes="primary"
                           Height="52"
                           FontSize="16"
                           HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center"
                           VerticalContentAlignment="Center">
                      ✓ Tạo sản phẩm
                   </Button>
                   
                   <Button Command="{Binding $parent[Window].Close}"
                           Classes="secondary"
                           HorizontalAlignment="Right"
                           Width="100"
                           Margin="0,20,0,0">
                      Thoát
                   </Button>
                   
                </StackPanel>
          </Border>
       </Grid>
    </Border>
</Window>