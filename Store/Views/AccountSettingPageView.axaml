<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Store.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="940"
             x:DataType="vm:AccountSettingPageViewModel"
             x:Class="Store.Views.AccountSettingPageView">
    
    <Design.DataContext>
       <vm:AccountSettingPageViewModel/>
    </Design.DataContext>

    <Border CornerRadius="16" 
            Background="{DynamicResource BgPage}" 
            Margin="10" 
            BoxShadow="0 4 20 0 #30000000">
       
       <Grid RowDefinitions="Auto,*">
          <Border Grid.Row="0" 
                  Background="{DynamicResource BgCard}" 
                  CornerRadius="16,16,0,0" 
                  Padding="30,25"
                  BorderBrush="{DynamicResource BorderColor}"
                  BorderThickness="0,0,0,1">
             <StackPanel>
                <TextBlock Text="Cài đặt tài khoản" 
                           Classes="header" 
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,10"/>
                <TextBlock Text="Quản lý thông tin cá nhân và bảo mật" 
                           Classes="body"
                           Foreground="{DynamicResource TextSecondary}"/>
             </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
             <StackPanel Spacing="20">
                
                <Border Classes="card" BoxShadow="0 2 8 0 #20000000">
                   <Grid ColumnDefinitions="Auto,*">
                      <Border Grid.Column="0"
                            Background="{DynamicResource BgHover}"
                            CornerRadius="60"
                            Width="120"
                            Height="120"
                            VerticalAlignment="Top"
                            Margin="0,0,30,0"
                            ClipToBounds="True">
                         <Image Source="{Binding HinhAnh}"
                               Width="120"
                               Height="120"
                               Stretch="UniformToFill"/>
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="15">
                         <StackPanel Spacing="10">
                            <TextBlock Text="Họ và tên" Classes="label"/>
                            <TextBox Text="{Binding HoTen, Mode=TwoWay}" 
                                     Classes="modern-input"
                                     IsReadOnly="True"/>
                         </StackPanel>

                         <StackPanel Spacing="10">
                            <TextBlock Text="Email" Classes="label"/>
                            <TextBox Text="{Binding Email, Mode=TwoWay}" 
                                     Classes="modern-input"
                                     IsReadOnly="True"/>
                         </StackPanel>

                         <StackPanel Spacing="10">
                            <TextBlock Text="Số điện thoại" Classes="label"/>
                            <TextBox Text="{Binding SDT, Mode=TwoWay}" 
                                     Classes="modern-input"
                                     IsReadOnly="True"/>
                         </StackPanel>
                      </StackPanel>
                   </Grid>
                </Border>

                <Border Classes="card" BoxShadow="0 2 8 0 #20000000">
                   <StackPanel Spacing="15">
                      <TextBlock Text="🔒 Bảo mật" 
                                 Classes="subheader"
                                 Foreground="{DynamicResource TextPrimary}"/>

                      <StackPanel Spacing="10">
                         <TextBlock Text="Mật khẩu hiện tại" Classes="label"/>
                         <TextBox Text="{Binding MatKhauNow, Mode=TwoWay}"
                                  Classes="modern-input"
                                  PasswordChar="●"/>
                      </StackPanel>

                      <StackPanel Spacing="10">
                         <TextBlock Text="Mật khẩu mới" Classes="label"/>
                         <TextBox Text="{Binding MatKhauNew, Mode=TwoWay}"
                                  Classes="modern-input"
                                  PasswordChar="●"/>
                      </StackPanel>

                      <StackPanel Spacing="10">
                         <TextBlock Text="Xác nhận mật khẩu mới" Classes="label"/>
                         <TextBox Text="{Binding MatKhauNewConfirm, Mode=TwoWay}"
                                  Classes="modern-input"
                                  PasswordChar="●"/>
                      </StackPanel>

                      <Button Classes="secondary" 
                              Command="{Binding DoiMatKhauButtonCommand}" 
                              Padding="15,10" 
                              HorizontalAlignment="Left">
                         🔑 Đổi mật khẩu
                      </Button>
                   </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Right" Margin="0 0 0 50">
                   <Button Classes="secondary" Padding="20,12">Hủy</Button>
                   <Button Classes="primary" Padding="20,12">💾 Lưu thay đổi</Button>
                </StackPanel>
             </StackPanel>
          </ScrollViewer>
       </Grid>
    </Border>
</UserControl>