<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             xmlns:vm="clr-namespace:Store.ViewModels"
             x:DataType="vm:OrderPageViewModel"
             x:Class="Store.Views.OrderPageView">
   
    <Design.DataContext>
       <vm:OrderPageViewModel/>
    </Design.DataContext>
    
    <Border CornerRadius="16" Background="{DynamicResource BgPage}" Margin="10" BoxShadow="0 4 20 0 #30000000">
        <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" Background="{DynamicResource BgCard}" CornerRadius="16,16,0,0" Padding="20,20,20,15">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Danh sách hóa đơn" Classes="header" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                        <TextBlock Text="Quản lý thông tin hóa đơn" Classes="body" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Classes="primary"
                            Height="42"
                            Padding="24,0"
                            Command="{Binding CreateBillButtonCommand}"
                            VerticalAlignment="Center">
                        + Tạo hóa đơn
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Padding="20,15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5">
                        <ComboBox Background="{DynamicResource BgInput}"
                                  BorderThickness="0"
								          ItemsSource="{Binding DanhSachBoLoc}"
                                  Width="180"
                                  PlaceholderForeground="{DynamicResource TextPlaceholder}"
                                  Foreground="{DynamicResource TextPrimary}"

                                  FontSize="14"
                                  PlaceholderText="Bộ lọc"
                                  Padding="12,8"
                                  CornerRadius="8"/>
                    </Border>
                    
                    <Border CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1.5">
                        <TextBox Background="{DynamicResource BgInput}"
                                 Foreground="{DynamicResource TextPrimary}"
                                 CaretBrush="{DynamicResource PrimaryColor}"
                                 BorderThickness="0"
                                 Width="400" 
                                 FontSize="14"
                                 Watermark="🔍 Tìm kiếm hoá đơn..."
                                 Text="{Binding SearchKeyword}"
                                 Padding="12,8"
                                 CornerRadius="8"/>
                    </Border>
                </StackPanel>
            </Border>
          
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,8,16,16" Background="Transparent">
             <Grid>
                <ItemsControl ItemsSource="{Binding HoaDons}"
                           IsVisible="{Binding HoaDons.Count}">
                   <ItemsControl.ItemTemplate>
                      <DataTemplate>
                            <Border Classes="card" BoxShadow="0 2 8 0 #20000000" Margin="0 10 0 10">
                               <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                  <Border Grid.Column="0"
                                        Background="{DynamicResource BgHover}"
                                        CornerRadius="10"
                                        Width="50"
                                        Height="50"
                                        VerticalAlignment="Center"
                                        Margin="0,0,15,0">
                                     <TextBlock Text="  📋  " FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  </Border>

                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                     <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}">
                                        <Run>Số hóa đơn : </Run>
                                        <Run  Text="{Binding SoHD}"></Run>
                                     </TextBlock>
                                     <TextBlock  FontSize="13" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0">
                                         <Run Text="Tên Khách hàng: "/>
                                        <Run Text="{Binding TenKH}" />
                                         
                                     </TextBlock>
                                  </StackPanel>

                                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                     <TextBlock Text="{Binding NgayLapHD}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right"/>
                                     
                                     <TextBlock   FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryColor}" TextAlignment="Right" Margin="0,5,0,0">
                                        <Run Text="{Binding TongTienHD}"/>
                                          <Run Text=" ₫"/>
                                     </TextBlock>
                                  </StackPanel>

                                  <Button Grid.Column="3"
                                        Command="{Binding $parent[ItemsControl].((vm:OrderPageViewModel)DataContext).ChiTietButtonCommand}"
                                        CommandParameter="{Binding}"
                                        Classes="secondary"
                                        Padding="12,8"
                                        VerticalAlignment="Center">
                                     Chi tiết
                                  </Button>
                               </Grid>
                            </Border>
                      </DataTemplate>
                   </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <Border Background="{DynamicResource BgCard}" 
                      CornerRadius="12" 
                      Padding="60,80"
                      IsVisible="{Binding !HoaDons.Count}">
                   <StackPanel HorizontalAlignment="Center" Spacing="15">
                      <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center"/>
                      <TextBlock Text="Chưa có hóa đơn nào" 
                               FontSize="18" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>
                      <TextBlock Text="Tạo hóa đơn đầu tiên để bắt đầu giao dịch" 
                               FontSize="14" 
                               Foreground="{DynamicResource TextSecondary}"
                               HorizontalAlignment="Center"/>
                      <Button Command="{Binding CreateBillButtonCommand}"
                            Classes="primary" 
                            Margin="75,10,0,0">
                         + Tạo hóa đơn
                      </Button>
                   </StackPanel>
                </Border>
             </Grid>
          </ScrollViewer>
       </Grid>
    </Border>
</UserControl>