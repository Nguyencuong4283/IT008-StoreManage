<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        Width="900"
        Height="600"
        TransparencyLevelHint="transparent"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        xmlns:vm="using:Store.ViewModels"
        x:DataType="vm:ForgotPasswordViewModel"
        x:Class="Store.ForgotPasswordView"
        Title="ForgotPasswordView">

    <Border CornerRadius="20" 
            ClipToBounds="True" 
            Height="600" 
            Width="900" 
            BoxShadow="0 10 40 5 #40000000"
            Background="{DynamicResource BgPage}">
       
       <Grid>
          <Border Height="600" 
                  Width="900" 
                  CornerRadius="16" 
                  BoxShadow="0 8 32 0 #30000000"
                  Background="{DynamicResource BgCard}">
             
             <Grid ColumnDefinitions="*,*">
                
                <Border Grid.Column="0" CornerRadius="16,0,0,16" ClipToBounds="True">
                   <Border.Background>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                         <GradientStop Color="#667EEA" Offset="0"/>
                         <GradientStop Color="#764BA2" Offset="1"/>
                      </LinearGradientBrush>
                   </Border.Background>
                   
                   <StackPanel VerticalAlignment="Center" Margin="50,0">
                      <TextBlock Text="🔐" 
                                 FontSize="80" 
                                 TextAlignment="Center"
                                 Margin="0,0,0,30"/>
                      <TextBlock FontSize="36" 
                                 FontWeight="Bold" 
                                 Foreground="White" 
                                 TextAlignment="Center"
                                 Margin="0,0,0,20">
                         Quên mật khẩu?
                      </TextBlock>
                      <TextBlock FontSize="16" 
                                 Foreground="#E0E0E0" 
                                 TextAlignment="Center"
                                 TextWrapping="Wrap"
                                 Margin="0,0,0,40">
                         Đừng lo lắng! Nhập email của bạn và chúng tôi sẽ gửi hướng dẫn khôi phục mật khẩu
                      </TextBlock>
                      
                      <Button Command="{Binding $parent[Window].Close}"
                              Background="Transparent" 
                              BorderBrush="White" 
                              BorderThickness="2"
                              Foreground="White"
                              CornerRadius="25" 
                              Height="50" 
                              Width="250"
                              FontSize="16"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              Cursor="Hand">
                          <Button.Styles>
                              <Style Selector="Button:pointerover /template/ ContentPresenter">
                                  <Setter Property="Background" Value="White"/>
                                  <Setter Property="Foreground" Value="#764BA2"/>
                              </Style>
                          </Button.Styles>
                         ← Quay lại đăng nhập
                      </Button>
                   </StackPanel>
                </Border>
                
                <Border Grid.Column="1" 
                        Background="{DynamicResource BgCard}" 
                        CornerRadius="0,16,16,0">
                   
                   <StackPanel VerticalAlignment="Center" Margin="60,0">
                      <TextBlock FontSize="28" 
                                 FontWeight="Bold" 
                                 Foreground="{DynamicResource TextPrimary}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,10">
                         Khôi phục tài khoản
                      </TextBlock>
                      <TextBlock FontSize="14" 
                                 Foreground="{DynamicResource TextSecondary}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,40">
                         Nhập email đã đăng ký
                      </TextBlock>
                      
                      <TextBlock Text="{Binding MessageError}"
                                 FontSize="14" 
                                 Foreground="{DynamicResource DangerColor}"
                                 TextAlignment="Center"
                                 Margin="0,0,0,10"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding MessageError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      
                      <TextBlock Text="{Binding MessageSuccess}"
                                 FontSize="14" 
                                 Foreground="#27AE60"
                                 TextAlignment="Center"
                                 Margin="0,0,0,10"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding MessageSuccess, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      
                      <TextBlock Text="Địa chỉ Email" 
                                 Classes="label"
                                 Margin="0,0,0,8"/>
                      
                      <TextBox Text="{Binding Email}"
                               Classes="modern-input"
                               Watermark="example@email.com"
                               Margin="0,0,0,30"/>
                      
                      <Button Command="{Binding ConfirmButtonCommand}" 
                              Classes="primary"
                              Height="50"
                              FontSize="16"
                              HorizontalAlignment="Stretch"
                              VerticalContentAlignment="Center"
                              HorizontalContentAlignment="Center"
                              IsEnabled="{Binding !IsLoading}">
                         <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Đang gửi..." IsVisible="{Binding IsLoading}"/>
                            <TextBlock Text="Gửi yêu cầu" IsVisible="{Binding !IsLoading}"/>
                         </StackPanel>
                      </Button>
                   </StackPanel>
                </Border>
             </Grid>
          </Border>
       </Grid>
    </Border>
</Window>