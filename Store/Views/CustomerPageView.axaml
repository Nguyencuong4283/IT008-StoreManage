<UserControl
d:DesignHeight="700"
d:DesignWidth="1000"
mc:Ignorable="d"
x:Class="Store.Views.CustomerPageView"
x:DataType="viewModel:CustomerPageViewModel"
xmlns="https://github.com/avaloniaui"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:viewModel="clr-namespace:Store.ViewModels"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Border CornerRadius="16" Background="White" Margin="10" BoxShadow="0 4 20 0 #30000000">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Header & Controls -->
            <Border Grid.Row="0" Background="#F7FAFC" CornerRadius="16,16,0,0" Padding="20,20,20,15">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Danh sách khách hàng" Classes="header" Margin="0,0,0,5"/>
                        <TextBlock Text="Quản lý thông tin khách hàng" Classes="body"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Classes="primary"
                            Height="42"
                            Padding="24,0"
							Command="{Binding TaoKhachHangButtonCommand}"
                            VerticalAlignment="Center">
                        + Tạo khách hàng
                    </Button>
                </Grid>
            </Border>

            <!-- Search & Filter -->
            <Border Grid.Row="1" Padding="20,15" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1.5">
                        <ComboBox Background="White"
                                  BorderThickness="0"
								  ItemsSource="{Binding DanhSachBoLoc}"
                                  Width="180" 
                                  FontSize="14"
								  PlaceholderForeground="Black"
                                  PlaceholderText="Bộ lọc"
                                  Padding="12,8"
                                  CornerRadius="8"/>
                    </Border>
                    
                    <Border CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1.5">
                        <TextBox Background="White"
                                 BorderThickness="0"
                                 Width="400" 
                                 FontSize="14"
                                 Watermark="🔍 Tìm kiếm khách hàng..."
                                 Padding="12,8"
                                 CornerRadius="8"/>
                    </Border>
                </StackPanel>
            </Border>
			
			<!-- Customer List -->
			<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,8,16,16" Background="White">
				<Grid>
					<!-- Customer List -->
					<ItemsControl ItemsSource="{Binding KhachHangs}"
								  IsVisible="{Binding KhachHangs.Count}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								
									<Border Classes="card" BoxShadow="0 2 8 0 #20000000" Margin="0 10 0 10">
										<Grid ColumnDefinitions="Auto,*,Auto,Auto">
											<!-- Icon -->
											<Border Grid.Column="0"
													Background="#F7FAFC"
													CornerRadius="10"
													Width="50"
													Height="50"
													VerticalAlignment="Center"
													Margin="0,0,15,0">
												<TextBlock Text=" 👻 " FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
											</Border>

											<!-- Info -->
											<StackPanel Grid.Column="1" VerticalAlignment="Center">
												<TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#2D3748">
													<Run>Mã khách hàng : </Run>
													<Run Text="{Binding MaKH}"></Run>
												</TextBlock>
												<TextBlock  FontSize="13" Foreground="#718096" Margin="0,5,0,0">
													<Run>Tên khách hàng : </Run>
													<Run  Text="{Binding TenKH}"></Run>
												</TextBlock>
											</StackPanel>

											<!-- Amount -->
											<StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
												<TextBlock Text="{Binding SDT}" FontSize="12" Foreground="#718096" TextAlignment="Right"/>
												<TextBlock Text="{Binding DiaChi}" FontSize="16" FontWeight="Bold" Foreground="#667EEA" TextAlignment="Right" Margin="0,5,0,0">

												</TextBlock>
											</StackPanel>

											<!-- Action -->
											<Button Grid.Column="3"
													Classes="secondary"
													Padding="12,8"
													VerticalAlignment="Center">
												Chi tiết
											</Button>
										</Grid>
									</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<!--Template-->
					<Border Background="#F7FAFC"
							CornerRadius="12"
							Padding="60,80"
							IsVisible="{Binding !KhachHangs.Count}">
						<StackPanel HorizontalAlignment="Center" Spacing="15">
							<TextBlock Text="👥" FontSize="64" HorizontalAlignment="Center"/>
							<TextBlock Text="Chưa có khách hàng nào"
									   FontSize="18"
									   FontWeight="SemiBold"
									   Foreground="#2D3748"
									   HorizontalAlignment="Center"/>
							<TextBlock Text="Tạo khách hàng đầu tiên để bắt đầu quản lý"
									   FontSize="14"
									   Foreground="#718096"
									   HorizontalAlignment="Center"/>
							<Button Command="{Binding TaoKhachHangButtonCommand}"
									Classes="primary"
									Margin="74,10,0,0">
								+ Tạo khách hàng
							</Button>
						</StackPanel>
					</Border>
				</Grid>
			</ScrollViewer>
		</Grid>
	</Border>
</UserControl>
