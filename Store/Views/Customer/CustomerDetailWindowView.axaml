<Window
    Background="Transparent"
    Height="800"
    SystemDecorations="None"
    Title="Chi tiết khách hàng"
    Width="650"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="800"
    d:DesignWidth="650"
    mc:Ignorable="d"
    x:Class="Store.Views.Customer.CustomerDetailWindowView"
    x:DataType="vm:CustomerDetailWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Customer"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
        CornerRadius="20">

        <Grid>
            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                HorizontalAlignment="Right"
                Margin="0,5,10,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <Border
                Background="{DynamicResource BgCard}"
                BoxShadow="0 8 32 0 #20000000"
                CornerRadius="16"
                Margin="60,70,60,60"
                Padding="50,40">
                <StackPanel>
                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Margin="0,0,0,40"
                        TextAlignment="Center">
                        Thông tin khách hàng
                    </TextBlock>

                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Mã khách hàng" />
                            <TextBox
                                Classes="modern-input"
                                Foreground="{DynamicResource PrimaryText}"
                                IsReadOnly="True"
                                Text="{Binding MaKH}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Tên khách hàng" />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                Text="{Binding TenKH, Mode=TwoWay}"
                                Watermark="Nguyễn Văn A" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Số điện thoại" />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                Text="{Binding SDT, Mode=TwoWay}"
                                Watermark="+84 xxx xxx xxx" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Giới tính" />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                Text="{Binding GioiTinh, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Tổng tiền " />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                Text="{Binding TongMua, Mode=TwoWay}" />

                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Hạng" />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                Text="{Binding Hang, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Classes="label" Text="Địa chỉ" />
                        <TextBox
                            AcceptsReturn="True"
                            Classes="modern-input"
                            Height="40"
                            IsReadOnly="True"
                            Text="{Binding DiaChi, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            Watermark="Nhập địa chỉ đầy đủ..." />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Classes="label" Text="Ghi chú" />
                        <TextBox
                            AcceptsReturn="True"
                            Classes="modern-input"
                            Height="60"
                            IsReadOnly="True"
                            Text="{Binding GhiChu, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            Watermark="Thêm ghi chú (tùy chọn)..." />
                    </StackPanel>

                    <Button
                        Classes="danger"
                        Command="{Binding DeleteCustomerButtonCommand}"
                        FontSize="16"
                        Height="52"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center">
                        🗑️ Xóa khách hàng
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>

</Window>
