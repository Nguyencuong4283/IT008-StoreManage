<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="700" 
             d:DesignWidth="1000"
             x:Class="Store.Views.HistoryPageView">
    
    <Border CornerRadius="16" 
            Background="{DynamicResource BgPage}" 
            Margin="10" 
            BoxShadow="0 4 20 0 #30000000">
        
        <Grid RowDefinitions="Auto,Auto,*">
            <Border Grid.Row="0" 
                    Background="{DynamicResource BgCard}" 
                    CornerRadius="16,16,0,0" 
                    Padding="20,20,20,15"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Lịch sử nhập kho" 
                                   Classes="header" 
                                   Foreground="{DynamicResource TextPrimary}"
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Theo dõi các đợt nhập hàng vào kho" 
                                   Classes="body"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                    
                    <Button Grid.Column="1" 
                            Classes="primary"
                            Height="42"
                            Padding="24,0"
                            VerticalAlignment="Center">
                        + Nhập kho mới
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" 
                    Padding="20,15" 
                    BorderBrush="{DynamicResource BorderColor}" 
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    
                    <ComboBox Classes="modern-combo"
                              Width="180" 
                              PlaceholderText="Lọc theo tháng"/>
                    
                    <TextBox Classes="modern-input"
                             Width="400" 
                             Watermark="🔍 Tìm kiếm phiếu nhập..."/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="20" Background="Transparent">
                <StackPanel Spacing="12">
                    <Border Classes="card" BoxShadow="0 2 8 0 #20000000">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <Border Grid.Column="0" 
                                    Background="{DynamicResource BgHover}" 
                                    CornerRadius="10" 
                                    Width="50" 
                                    Height="50"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0">
                                <TextBlock Text="📦" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Phiếu nhập #NK001" 
                                           FontSize="15" 
                                           FontWeight="SemiBold" 
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Ngày nhập: 01/01/2024" 
                                           FontSize="13" 
                                           Foreground="{DynamicResource TextSecondary}" 
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="20,0">
                                <TextBlock Text="Tổng giá trị" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextSecondary}" 
                                           TextAlignment="Right"/>
                                <TextBlock FontSize="16" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource PrimaryColor}" 
                                           TextAlignment="Right" 
                                           Margin="0,5,0,0">
                                    <Run Text="0"/>
                                    <Run Text=" ₫" FontSize="13"/>
                                </TextBlock>
                            </StackPanel>

                            <Button Grid.Column="3" 
                                    Classes="secondary" 
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                Chi tiết
                            </Button>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource BgCard}" 
                            CornerRadius="12" 
                            Padding="40"
                            Margin="0,20,0,0">
                        <StackPanel HorizontalAlignment="Center" Spacing="15">
                            <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center"/>
                            <TextBlock Text="Chưa có lịch sử nhập kho" 
                                       FontSize="18" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Tạo phiếu nhập kho đầu tiên để bắt đầu" 
                                       FontSize="14" 
                                       Foreground="{DynamicResource TextSecondary}"
                                       HorizontalAlignment="Center"/>
                            <Button Classes="primary" Margin="70,10,0,0">+ Nhập kho mới</Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>