<Window
    Background="Transparent"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    Height="600"
    Icon="/Assets/avalonia-logo.ico"
    SystemDecorations="Full"
    Title="ShopQuality - Đăng nhập"
    TransparencyLevelHint="acrylicBlur"
    Width="900"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d"
    x:Class="Store.Views.Auth.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Auth"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BoxShadow="0 10 40 5 #40000000"
        ClipToBounds="True"
        CornerRadius="16">

        <Grid>
            <Grid ColumnDefinitions="*,*">

                <Border Grid.Column="0" Padding="60,80">
                    <StackPanel Spacing="30" VerticalAlignment="Center">
                        <Border
                            Background="{DynamicResource PrimaryColor}"
                            BoxShadow="0 8 24 0 #30000000"
                            CornerRadius="20"
                            Height="80"
                            HorizontalAlignment="Center"
                            Width="80">
                            <TextBlock
                                FontSize="48"
                                HorizontalAlignment="Center"
                                Text="🛍️"
                                VerticalAlignment="Center" />
                        </Border>

                        <TextBlock
                            FontSize="36"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            TextAlignment="Center">
                            ShopQ<Run FontSize="18" Foreground="{DynamicResource PrimaryColor}">uality</Run>
                        </TextBlock>

                        <TextBlock
                            FontSize="15"
                            Foreground="{DynamicResource TextSecondary}"
                            LineHeight="22"
                            Text="Phần mềm quản lý bán hàng hiện đại"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Border
                            Background="{DynamicResource BorderColor}"
                            Height="1"
                            Margin="40,10" />

                        <StackPanel Spacing="12">
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Chưa có tài khoản?"
                                TextAlignment="Center" />
                            <Button
                                Classes="secondary"
                                Command="{Binding RegisterButtonCommand}"
                                Height="44"
                                HorizontalAlignment="Stretch">
                                Đăng ký ngay
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Background="{DynamicResource BgCard}"
                    BoxShadow="-4 0 16 0 #10000000"
                    CornerRadius="0,16,16,0"
                    Grid.Column="1">

                    <StackPanel
                        Margin="60,0"
                        Spacing="20"
                        VerticalAlignment="Center">
                        <StackPanel Margin="0,0,0,16" Spacing="8">
                            <TextBlock
                                FontSize="28"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="Đăng nhập" />
                            <TextBlock
                                FontSize="14"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Nhập thông tin để tiếp tục" />
                        </StackPanel>

                        <Border
                            Background="{DynamicResource BgInput}"
                            BorderBrush="{DynamicResource DangerColor}"
                            BorderThickness="1"
                            CornerRadius="8"
                            IsVisible="{Binding KiemTraDangNhap, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="12">
                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource DangerColor}"
                                Text="{Binding KiemTraDangNhap}"
                                TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Tên đăng nhập" />
                            <TextBox
                                Classes="modern-input"
                                Name="UsernameTextBox"
                                Text="{Binding TenDangNhap}"
                                Watermark="Nhập tên đăng nhập">
                                <Interaction.Behaviors>
                                    <FocusOnAttachedBehavior />
                                </Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="label" Text="Mật khẩu" />
                            <TextBox
                                Classes="modern-input"
                                PasswordChar="●"
                                Text="{Binding MatKhau}"
                                Watermark="Nhập mật khẩu" />
                        </StackPanel>

                        <Button
                            Background="Transparent"
                            BorderThickness="0"
                            Command="{Binding ForgotPasswordButtonCommand}"
                            Cursor="Hand"
                            FontSize="13"
                            Foreground="{DynamicResource PrimaryColor}"
                            HorizontalAlignment="Right"
                            Padding="0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryHover}" />
                                </Style>
                            </Button.Styles>
                            Quên mật khẩu?
                        </Button>

                        <Button
                            Classes="primary"
                            Command="{Binding LogInButtonCommand}"
                            FontSize="15"
                            Height="44"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0">
                            Đăng nhập
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>