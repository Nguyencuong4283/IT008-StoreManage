<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:vm="using:Store.ViewModels.Auth"
		mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
		Height="800"
		Width="1200"
		TransparencyLevelHint="transparent"
		Background="Transparent"
		SystemDecorations="None"
		WindowStartupLocation="CenterScreen"
		x:DataType="vm:CreateAcountWindowViewModel"
		x:Class="Store.Views.Auth.CreateAcountWindowView"
		Title="CreateAcountWindowView">

	<Window.DataContext>
		<vm:CreateAcountWindowViewModel />
	</Window.DataContext>

	<Border CornerRadius="16"
			Height="750"
			Width="1200"
			ClipToBounds="True"
			BoxShadow="0 10 40 5 #30000000"
			Background="Transparent">

		<Grid>

			<Border Background="{DynamicResource BgCard}"
					CornerRadius="16"
					Margin="70,0,70,50"
					BoxShadow="0 8 32 0 #15000000">
				<ScrollViewer VerticalScrollBarVisibility="Auto">

					<Grid RowDefinitions="50,*">

						<Grid Background="Transparent">
							<Button Command="{Binding $parent[Window].Close}"
									Classes="close-btn"
									HorizontalAlignment="Right"
									VerticalAlignment="Top"
									Margin="0,10,11,0"
									IsTabStop="False"
									ZIndex="10">
								✕
							</Button>
						</Grid>
						<Grid Grid.Row="1">

							<Grid ColumnDefinitions="360,*" Margin="40">

								<StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,30,30,0">
									<TextBlock FontSize="24"
											   FontWeight="Bold"
											   Foreground="{DynamicResource TextPrimary}"
											   TextAlignment="Center"
											   Margin="0,0,0,32">
										Đăng ký tài khoản
									</TextBlock>

									<Border Background="{DynamicResource BgHover}"
											CornerRadius="260"
											Width="260"
											Height="260"
											BoxShadow="0 4 12 0 #10000000"
											ClipToBounds="True"
											Margin="0,0,0,16">
										<Image Source="{Binding HinhAnh, Mode=TwoWay}"
											   Stretch="Fill" />
									</Border>

									<Button Command="{Binding ThemAnhButtonCommand}"
											Classes="primary"
											Width="260"
											Height="42"
											FontSize="14"
											HorizontalAlignment="Center">
										📷 Chọn ảnh đại diện
									</Button>
								</StackPanel>

								<StackPanel Grid.Column="1" Margin="0,30,0,0">

									<Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
										<StackPanel Grid.Column="0" Margin="0,0,8,0">
											<TextBlock Text="Tên đăng nhập" Classes="label" />
											<TextBox Text="{Binding TenDangNhap, Mode=TwoWay}"
													 Classes="modern-input"
													 Watermark="Nhập tên đăng nhập">
												<Interaction.Behaviors>
													<FocusOnAttachedBehavior />
												</Interaction.Behaviors>
											</TextBox>
										</StackPanel>

										<StackPanel Grid.Column="1" Margin="8,0,0,0">
											<TextBlock Text="Mật khẩu" Classes="label" />
											<TextBox Text="{Binding MatKhau, Mode=TwoWay}"
													 Classes="modern-input"
													 PasswordChar="●"
													 Watermark="Nhập mật khẩu" />
										</StackPanel>
									</Grid>

									<Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
										<StackPanel Grid.Column="0" Margin="0,0,8,0">
											<TextBlock Text="Họ và tên" Classes="label" />
											<TextBox Text="{Binding HoTen, Mode=TwoWay}"
													 Classes="modern-input"
													 Watermark="Nhập họ và tên" />
										</StackPanel>

										<StackPanel Grid.Column="1" Margin="8,0,0,0">
											<TextBlock Text="Giới tính" Classes="label" />
											<ComboBox ItemsSource="{Binding DanhSachGioiTinh}"
													  SelectedItem="{Binding GioiTinh, Mode=TwoWay}"
													  Classes="modern-combo"
													  Width="300"
													  HorizontalAlignment="Left"
													  PlaceholderText="Chọn giới tính" />
										</StackPanel>
									</Grid>

									<Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
										<StackPanel Grid.Column="0" Margin="0,0,8,0">
											<TextBlock Text="Ngày sinh" Classes="label" />
											<CalendarDatePicker SelectedDate="{Binding NgaySinh, Mode=TwoWay}"
																Classes="calendar"
																HorizontalAlignment="Left"
																Width="300" />
										</StackPanel>

										<StackPanel Grid.Column="1" Margin="8,0,0,0">
											<TextBlock Text="Số điện thoại" Classes="label" />
											<TextBox Text="{Binding SDT, Mode=TwoWay}"
													 Classes="modern-input"
													 Watermark="+84 xxx xxx xxx" />
										</StackPanel>
									</Grid>

									<StackPanel Margin="0,0,0,16">
										<TextBlock Text="Email" Classes="label" />
										<TextBox Text="{Binding Email, Mode=TwoWay}"
												 Classes="modern-input"
												 Watermark="example@email.com" />
									</StackPanel>

									<StackPanel Margin="0,0,0,24">
										<TextBlock Text="Địa chỉ" Classes="label" />
										<TextBox Text="{Binding DiaChi, Mode=TwoWay}"
												 Classes="modern-input"
												 AcceptsReturn="True"
												 TextWrapping="Wrap"
												 Height="80"
												 Watermark="Nhập địa chỉ đầy đủ"
												 VerticalContentAlignment="Top" />
									</StackPanel>

									<Button Command="{Binding DangKyButtonCommand}"
											Classes="primary"
											Height="44"
											FontSize="14"
											HorizontalAlignment="Stretch">
										✓ Tạo tài khoản
									</Button>
								</StackPanel>
							</Grid>

						</Grid>
					</Grid>
				</ScrollViewer>
			</Border>
		</Grid>
	</Border>
</Window>