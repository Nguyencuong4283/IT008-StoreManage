<Window
    Background="Transparent"
    Height="800"
    SystemDecorations="None"
    Title="CreateAcountWindowView"
    TransparencyLevelHint="transparent"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    x:Class="Store.Views.Auth.CreateAcountWindowView"
    x:DataType="vm:CreateAcountWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Auth"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.DataContext>
        <vm:CreateAcountWindowViewModel />
    </Window.DataContext>

    <Border
        Background="Transparent"
        BoxShadow="0 10 40 5 #30000000"
        ClipToBounds="True"
        CornerRadius="16"
        Height="750"
        Width="1200">

        <Grid>

            <Border
                Background="{DynamicResource BgCard}"
                BoxShadow="0 8 32 0 #15000000"
                CornerRadius="16"
                Margin="70,0,70,50">
                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <Grid RowDefinitions="50,*">

                        <Grid Background="Transparent">
                            <Button
                                Classes="close-btn"
                                Command="{Binding $parent[Window].Close}"
                                HorizontalAlignment="Right"
                                IsTabStop="False"
                                Margin="0,10,11,0"
                                VerticalAlignment="Top"
                                ZIndex="10">
                                ✕
                            </Button>

                        </Grid>
                        <Grid Grid.Row="1">

                            <Grid ColumnDefinitions="360,*" Margin="40">

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="0,30,30,0"
                                    VerticalAlignment="Top">
                                    <TextBlock
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Margin="0,0,0,32"
                                        TextAlignment="Center">
                                        Đăng ký tài khoản
                                    </TextBlock>

                                    <Border
                                        Background="{DynamicResource BgHover}"
                                        BoxShadow="0 4 12 0 #10000000"
                                        ClipToBounds="True"
                                        CornerRadius="260"
                                        Height="260"
                                        Margin="0,0,0,16"
                                        Width="260">
                                        <Image Source="{Binding HinhAnh, Mode=TwoWay}" Stretch="Fill" />
                                    </Border>

                                    <Button
                                        Classes="primary"
                                        Command="{Binding InsertPictureButtonCommand}"
                                        FontSize="14"
                                        Height="42"
                                        HorizontalAlignment="Center"
                                        Width="260">
                                        📷 Chọn ảnh đại diện
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                    <Border
                                        Background="{DynamicResource BgInput}"
                                        BorderBrush="{DynamicResource DangerColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        IsVisible="{Binding KiemTraDangNhap, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                        Margin="0,0,0,16"
                                        Padding="12">
                                        <TextBlock
                                            FontSize="13"
                                            Foreground="{DynamicResource DangerColor}"
                                            Text="{Binding KiemTraDangNhap}"
                                            TextWrapping="Wrap" />
                                    </Border>

                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Classes="label" Text="Tên đăng nhập" />
                                            <TextBox
                                                Classes="modern-input"
                                                Text="{Binding TenDangNhap, Mode=TwoWay}"
                                                Watermark="Nhập tên đăng nhập">
                                                <Interaction.Behaviors>
                                                    <FocusOnAttachedBehavior />
                                                </Interaction.Behaviors>
                                            </TextBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Classes="label" Text="Mật khẩu" />
                                            <TextBox
                                                Classes="modern-input"
                                                PasswordChar="●"
                                                Text="{Binding MatKhau, Mode=TwoWay}"
                                                Watermark="Nhập mật khẩu" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Classes="label" Text="Họ và tên" />
                                            <TextBox
                                                Classes="modern-input"
                                                Text="{Binding HoTen, Mode=TwoWay}"
                                                Watermark="Nhập họ và tên" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Classes="label" Text="Giới tính" />
                                            <ComboBox
                                                Classes="modern-combo"
                                                HorizontalAlignment="Left"
                                                ItemsSource="{Binding DanhSachGioiTinh}"
                                                PlaceholderText="Chọn giới tính"
                                                SelectedItem="{Binding GioiTinh, Mode=TwoWay}"
                                                Width="300" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Classes="label" Text="Ngày sinh" />
                                            <CalendarDatePicker
                                                Classes="calendar"
                                                HorizontalAlignment="Left"
                                                SelectedDate="{Binding NgaySinh, Mode=TwoWay}"
                                                Width="300" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Classes="label" Text="Số điện thoại" />
                                            <TextBox
                                                Classes="modern-input"
                                                Text="{Binding SDT, Mode=TwoWay}"
                                                Watermark="+84 xxx xxx xxx" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Classes="label" Text="Email" />
                                        <TextBox
                                            Classes="modern-input"
                                            Text="{Binding Email, Mode=TwoWay}"
                                            Watermark="example@email.com" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,24">
                                        <TextBlock Classes="label" Text="Địa chỉ" />
                                        <TextBox
                                            AcceptsReturn="True"
                                            Classes="modern-input"
                                            Height="80"
                                            Text="{Binding DiaChi, Mode=TwoWay}"
                                            TextWrapping="Wrap"
                                            VerticalContentAlignment="Top"
                                            Watermark="Nhập địa chỉ đầy đủ" />
                                    </StackPanel>

                                    <Button
                                        Classes="primary"
                                        Command="{Binding RegisterButtonCommand}"
                                        FontSize="14"
                                        Height="44"
                                        HorizontalAlignment="Stretch">
                                        ✓ Tạo tài khoản
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>