<Window
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:Store.ViewModels"
mc:Ignorable="d"
Icon="/Assets/avalonia-logo.ico"
Title="ShopQuality - Admin"
Height="800"
Width="1200"
WindowStartupLocation="CenterScreen"
d:DesignHeight="800"
d:DesignWidth="1200"
x:Class="Store.Views.AdminWindowView"
x:DataType="vm:AdminWindowViewModel">

	<Grid ColumnDefinitions="240,*" RowDefinitions="70,*">
		<!-- Top Bar with Gradient -->
		<Border Grid.Column="0" Grid.ColumnSpan="2" BoxShadow="0 2 8 0 #15000000">
			<Border.Background>
				<LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
					<GradientStop Color="#667EEA" Offset="0"/>
					<GradientStop Color="#764BA2" Offset="1"/>
				</LinearGradientBrush>
			</Border.Background>
			<Grid ColumnDefinitions="240,*,Auto" Margin="20,0">
				<!-- Logo -->
				<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" >
					<TextBlock Text="🛍️" FontSize="28"/>
					<TextBlock Text="ShopQuality"
							   FontSize="20"
							   FontWeight="Bold"
							   Foreground="White"
							   VerticalAlignment="Center"/>
				</StackPanel>

				<!-- Search Bar -->
				<Border Grid.Column="1"
						Classes="border1"

						MaxWidth="500"
						Height="42"
						Margin="20,0">
					<TextBox Background="Transparent"
							 Foreground="Black"
							 Classes="modern-input"
							 BorderThickness="0"
							 FontSize="14"
							 Height="42"
							 Watermark="🔍 Tìm kiếm..."
							 Padding="12,0"
							 VerticalAlignment="Center"
							 VerticalContentAlignment="Center">
						
					</TextBox>
				</Border>

				<!-- User Actions -->
				<StackPanel Grid.Column="2"
							Orientation="Horizontal"
							Spacing="8"
							VerticalAlignment="Center">
					<Button Background="White"
							BorderThickness="0"
							Width="38"
							Height="38"
							CornerRadius="8"
							Cursor="Hand">
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="#FFFFFF30"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="🔔" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Button>
					<Button Background="White"
							BorderThickness="0"
							Width="38"
							Height="38"
							CornerRadius="8"
							Cursor="Hand">
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="Black"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="💬" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Button>
					<Button Background="White"
							BorderThickness="0"
							Width="38"
							Height="38"
							CornerRadius="8"
							Cursor="Hand">
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background" Value="White"/>
							</Style>
						</Button.Styles>
						<TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!-- Sidebar with White Background -->
		<Border Grid.Column="0" Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,0,1,0">
			<Grid RowDefinitions="*,Auto">
				<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
					<StackPanel Margin="12" Spacing="4">
						<Button Command="{Binding GoHomeCommand}"
								Background="White"
								Classes="sidebar"
								Foreground="#374151"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="🏠" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Tổng quan" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoBillCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="📋" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Đơn hàng" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoProductCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="📦" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Sản phẩm" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoCustomerCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="👻" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Khách hàng" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoIncomeCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="💰" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Thu nhập" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoHistoryCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="📥" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Nhập kho" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoEmployeeCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="📂" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Nhân sự" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>

						<Button Command="{Binding GoAccountSettingCommand}"
								Background="White"
								Foreground="#374151"
								Classes="sidebar"
								BorderBrush="#E5E7EB"
								BorderThickness="1"
								CornerRadius="8"
								Padding="12,10"
								Cursor="Hand"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Left"
								Margin="0,0,0,0">
							<Button.Styles>
								<Style Selector="Button:pointerover">
									<Setter Property="Background">
										<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
											<GradientStop Color="#F9FAFB" Offset="0"/>
											<GradientStop Color="#F3F4F6" Offset="1"/>
										</LinearGradientBrush>
									</Setter>
									<Setter Property="BorderBrush" Value="#667EEA"/>
									<Setter Property="BorderThickness" Value="2"/>
									<Setter Property="Margin" Value="0,-2,0,2"/>
								</Style>
							</Button.Styles>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="👤" FontSize="18" VerticalAlignment="Center"/>
								<TextBlock Text="Tài khoản" FontSize="14" VerticalAlignment="Center"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</ScrollViewer>

				<!-- Settings at Bottom -->
				<Border Grid.Row="1" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="12">
					<Button Command="{Binding GoSettingCommand}"
							Background="White"
							Foreground="#374151"
							Classes="sidebar"
							BorderBrush="#E5E7EB"
							BorderThickness="1"
							CornerRadius="8"
							Padding="12,10"
							Cursor="Hand"
							HorizontalAlignment="Stretch"
							HorizontalContentAlignment="Left"
							Margin="0,0,0,0">
						<Button.Styles>
							<Style Selector="Button:pointerover">
								<Setter Property="Background">
									<LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
										<GradientStop Color="#F9FAFB" Offset="0"/>
										<GradientStop Color="#F3F4F6" Offset="1"/>
									</LinearGradientBrush>
								</Setter>
								<Setter Property="BorderBrush" Value="#667EEA"/>
								<Setter Property="BorderThickness" Value="2"/>
								<Setter Property="Margin" Value="0,-2,0,2"/>
							</Style>
						</Button.Styles>
						<StackPanel Orientation="Horizontal" Spacing="10">
							<TextBlock Text="⚙️" FontSize="18" VerticalAlignment="Center"/>
							<TextBlock Text="Cài đặt" FontSize="14" VerticalAlignment="Center"/>
						</StackPanel>
					</Button>
				</Border>
			</Grid>
		</Border>

		<!-- Main Content Area -->
		<Border Grid.Column="1" Grid.Row="1" Background="#F3F4F6" Padding="20">
			<ContentControl Content="{Binding CurrentPage}" />
		</Border>
	</Grid>
</Window>
