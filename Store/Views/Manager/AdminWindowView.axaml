<Window
    Background="Transparent"
    CanMaximize="True"
    CanMinimize="True"
    CanResize="True"
    ExtendClientAreaToDecorationsHint="True"
    Height="810"
    Icon="/Assets/avalonia-logo.ico"
    SystemDecorations="None"
    Title="ShopQuality - Admin"
    TransparencyLevelHint="transparent"
    Width="1200"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="810"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    x:Class="Store.Views.Manager.AdminWindowView"
    x:DataType="vm:AdminWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Manager"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Styles>
        <Style Selector="Button.sidebar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="Button.sidebar:pointerover /template/ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button.top-icon">
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.top-icon:pointerover /template/ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

    </Window.Styles>

    <Border
        Background="{DynamicResource BgPage}"
        BoxShadow="0 10 40 5 #30000000"
        ClipToBounds="True"
        CornerRadius="16">

        <Grid ColumnDefinitions="240,*" RowDefinitions="80,*">

            <Border
                BoxShadow="0 2 8 0 #15000000"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                PointerPressed="Header_PointerPressed">
                <Border.Background>
                    <LinearGradientBrush EndPoint="100%,0%" StartPoint="0%,0%">
                        <GradientStop Color="#667EEA" Offset="0" />
                        <GradientStop Color="#764BA2" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="240,*,Auto" Margin="20,0">
                    <Grid RowDefinitions="15,*">

                        <StackPanel Margin="0,15,0,0" Orientation="Horizontal">
                            <Button Classes="MacBtn CloseBtn" Click="CloseBtn" IsTabStop="False" />
                            <Button Classes="MacBtn MinBtn" Click="MinimizeBtn" IsTabStop="False" />
                            <Button Classes="MacBtn MaxBtn" Click="MaximizeBtn" IsTabStop="False" />
                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                            <TextBlock FontSize="28" Text="🛍️" />
                            <TextBlock
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="ShopQuality"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border
                        Grid.Column="1"
                        Height="42"
                        Margin="20,0"
                        MaxWidth="500" />

                    <Grid Grid.Column="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="White"
                                HorizontalAlignment="Left"
                                Margin="0,0,15,0"
                                Text="{Binding CurrentTime}"
                                TextAlignment="Center"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0"
                Grid.Column="0"
                Grid.Row="1"
                KeyboardNavigation.TabNavigation="Cycle">

                <Grid RowDefinitions="*,Auto" KeyboardNavigation.TabNavigation="Cycle">
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12" Spacing="4" KeyboardNavigation.TabNavigation="Cycle" >
                            <Button Classes="sidebar" Command="{Binding GoHomeCommand}" TabIndex="1" Name="HomeButton">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="🏠"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Tổng quan"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoBillCommand}" TabIndex="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="📋"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Đơn hàng"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoProductCommand}" TabIndex="3">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="📦"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Sản phẩm"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoCustomerCommand}" TabIndex="4">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="👻"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Khách hàng"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoIncomeCommand}" TabIndex="5">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="💰"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Thu nhập"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoHistoryCommand}" TabIndex="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="📥"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Nhập kho"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoEmployeeCommand}" TabIndex="7">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="📂"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Nhân sự"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Classes="sidebar" Command="{Binding GoAccountSettingCommand}" TabIndex="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="👤"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Tài khoản"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>


                        </StackPanel>
                    </ScrollViewer>

                    <Border
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Grid.Row="1"
                        Padding="12">
                        <StackPanel>
                            <Button Classes="sidebar" Click="LogoutButton_Click" TabIndex="9">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="🚪"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Đăng xuất"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="sidebar" Command="{Binding GoSettingCommand}" TabIndex="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        FontSize="18"
                                        Text="⚙️"
                                        VerticalAlignment="Center" />
                                    <TextBlock
                                        FontSize="14"
                                        Text="Cài đặt"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border
                Background="{DynamicResource BgPage}"
                Grid.Column="1"
                Grid.Row="1"
                Padding="20">
                <ContentControl Content="{Binding CurrentPage}" />
            </Border>

        </Grid>
    </Border>
</Window>