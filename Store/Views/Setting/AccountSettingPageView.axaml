<UserControl
    d:DesignHeight="940"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Store.Views.Setting.AccountSettingPageView"
    x:DataType="vm:AccountSettingPageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Store.ViewModels.Setting"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Design.DataContext>
        <vm:AccountSettingPageViewModel />
    </Design.DataContext>

    <Border
        Background="{DynamicResource BgPage}"
        BoxShadow="0 4 20 0 #30000000"
        CornerRadius="16"
        Margin="10">

        <Grid RowDefinitions="Auto,*">
            <Border
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                CornerRadius="16,16,0,0"
                Grid.Row="0"
                Padding="30,25">
                <StackPanel>
                    <TextBlock
                        Classes="header"
                        Foreground="{DynamicResource TextPrimary}"
                        Margin="0,0,0,10"
                        Text="Cài đặt tài khoản" />
                    <TextBlock
                        Classes="body"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="Quản lý thông tin cá nhân và bảo mật" />
                </StackPanel>
            </Border>

            <ScrollViewer
                Grid.Row="1"
                Padding="30"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">

                    <Border BoxShadow="0 2 8 0 #20000000" Classes="card">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border
                                Background="{DynamicResource BgHover}"
                                ClipToBounds="True"
                                CornerRadius="60"
                                Grid.Column="0"
                                Height="120"
                                Margin="0,0,30,0"
                                VerticalAlignment="Top"
                                Width="120">
                                <Image
                                    Height="120"
                                    Source="{Binding HinhAnh}"
                                    Stretch="UniformToFill"
                                    Width="120" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="15">
                                <StackPanel Spacing="10">
                                    <TextBlock Classes="label" Text="Họ và tên" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding HoTen, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Classes="label" Text="Email" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding Email, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Spacing="10">
                                    <TextBlock Classes="label" Text="Số điện thoại" />
                                    <TextBox
                                        Classes="modern-input"
                                        IsReadOnly="True"
                                        Text="{Binding SDT, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border BoxShadow="0 2 8 0 #20000000" Classes="card">
                        <StackPanel Margin="0,0,0,70" Spacing="15">
                            <TextBlock
                                Classes="subheader"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="🔒 Bảo mật" />

                            <StackPanel Spacing="10">
                                <TextBlock Classes="label" Text="Mật khẩu hiện tại" />
                                <TextBox
                                    Classes="modern-input"
                                    PasswordChar="●"
                                    Text="{Binding MatKhauNow, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Classes="label" Text="Mật khẩu mới" />
                                <TextBox
                                    Classes="modern-input"
                                    PasswordChar="●"
                                    Text="{Binding MatKhauNew, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Spacing="10">
                                <TextBlock Classes="label" Text="Xác nhận mật khẩu mới" />
                                <TextBox
                                    Classes="modern-input"
                                    PasswordChar="●"
                                    Text="{Binding MatKhauNewConfirm, Mode=TwoWay}" />
                            </StackPanel>

                            <Button
                                Classes="secondary"
                                Command="{Binding ChangePasswordButtonCommand}"
                                HorizontalAlignment="Left"
                                Padding="15,10">
                                🔑 Đổi mật khẩu
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>