<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Store.ViewModels.Setting" 
             x:DataType="vm:SettingPageViewModel"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Store.Views.Setting.SettingPageView">
    
    <Design.DataContext>
        <vm:SettingPageViewModel/>
    </Design.DataContext>
    
    <Border CornerRadius="16" 
            Background="{DynamicResource BgPage}" 
            Margin="10" 
            BoxShadow="0 4 20 0 #15000000"> <Grid RowDefinitions="Auto,*">
            <Border Grid.Row="0" 
                    Background="{DynamicResource BgCard}" 
                    CornerRadius="16,16,0,0" 
                    Padding="30,25"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Cài đặt hệ thống" 
                               Classes="header" 
                               Foreground="{DynamicResource TextPrimary}"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Quản lý cấu hình và tùy chỉnh ứng dụng" 
                               Classes="body"
                               Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30">
                <StackPanel Spacing="20">
                    
                    <Border Classes="card" BoxShadow="0 2 8 0 #10000000">
                        <StackPanel Spacing="15">
                            <TextBlock Text="⚙️ Cài đặt chung" 
                                       Classes="subheader"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            
                            <StackPanel Spacing="10">
                                <TextBlock Text="Tên cửa hàng" 
                                           Classes="label"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBox Text="{Binding Setting1}" Classes="modern-input"/>
                            </StackPanel>

                          
                        </StackPanel>
                    </Border>

                    <Border Classes="card" BoxShadow="0 2 8 0 #10000000">
                        <StackPanel Spacing="15">
                            <TextBlock Text="🎨 Giao diện" 
                                       Classes="subheader"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Chế độ tối" 
                                               FontSize="15" 
                                               FontWeight="Medium" 
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Bật chế độ giao diện tối" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource TextSecondary}" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" 
                                              VerticalAlignment="Center" 
                                              IsChecked="{Binding IsDarkMode}"/>
                            </Grid>

                            <Separator Background="{DynamicResource BorderColor}" Height="1"/>

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Thông báo" 
                                               FontSize="15" 
                                               FontWeight="Medium" 
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Nhận thông báo về đơn hàng mới" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource TextSecondary}" 
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="True" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" BoxShadow="0 2 8 0 #10000000" Margin="0 0 0 50">
                        <StackPanel Spacing="15">
                            <TextBlock Text="ℹ️ Thông tin" 
                                       Classes="subheader"
                                       Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Phiên bản: 1.0.0" 
                                           FontSize="14" 
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="© 2025 ShopQuality. All rights reserved." 
                                           FontSize="14" 
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Classes="primary" 
                            HorizontalAlignment="Right" 
                            Padding="30,12">
                        💾 Lưu thay đổi
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>