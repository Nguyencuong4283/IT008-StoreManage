<Window
    Background="Transparent"
    Height="700"
    SystemDecorations="None"
    Title="Create Product"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    x:Class="Store.Views.Product.CreateProductWindowView"
    x:DataType="vm:CreateProductWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Store.ViewModels.Product"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Background="{DynamicResource BgPage}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="2"
        BoxShadow="0 10 40 5 #40000000"
        ClipToBounds="True"
        CornerRadius="20">

        <Grid ColumnDefinitions="420,*">
            <Button
                Classes="close-btn"
                Command="{Binding $parent[Window].Close}"
                Grid.Column="1"
                HorizontalAlignment="Right"
                IsTabStop="False"
                Margin="0,15,15,0"
                VerticalAlignment="Top"
                ZIndex="10">
                ✕
            </Button>

            <StackPanel
                Grid.Column="0"
                Margin="40,60"
                VerticalAlignment="Center">
                <TextBlock
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Margin="0,0,0,30"
                    TextAlignment="Center">
                    Sản phẩm mới
                </TextBlock>

                <Border
                    Background="{DynamicResource BgInput}"
                    BoxShadow="0 4 16 0 #20000000"
                    ClipToBounds="True"
                    CornerRadius="16"
                    Height="340"
                    Margin="0,0,0,20"
                    Width="340">
                    <Image Source="{Binding HinhAnhSP}" Stretch="UniformToFill" />
                </Border>

                <Button
                    Classes="primary"
                    Command="{Binding InsertPictureButtonCommand}"
                    FontSize="15"
                    Height="48"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Width="340">
                    📷 Chọn hình ảnh
                </Button>
            </StackPanel>

            <Border
                Background="{DynamicResource BgCard}"
                CornerRadius="0,20,20,0"
                Grid.Column="1"
                Padding="40,60">

                <StackPanel>
                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Mã sản phẩm" />
                            <TextBox
                                Classes="modern-input"
                                IsReadOnly="True"
                                IsTabStop="False"
                                Text="{Binding MaSP}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Tên sản phẩm" />
                            <TextBox
                                Classes="modern-input"
                                Text="{Binding TenSP, Mode=TwoWay}"
                                Watermark="Nhập tên sản phẩm">
                                <Interaction.Behaviors>
                                    <FocusOnAttachedBehavior />
                                </Interaction.Behaviors>
                            </TextBox>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Giá sản phẩm (VND)" />

                            <Border
                                Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Height="41">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Text="{Binding GiaSP, Mode=TwoWay}"
                                        VerticalContentAlignment="Center" />

                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding IncreasePriceCommand}"
                                        Content="▲"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />

                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DecreasePriceCommand}"
                                        Content="▼"
                                        CornerRadius="0,8,8,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Loại sản phẩm" />
                            <ComboBox
                                Classes="modern-combo"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding DanhSachLoaiSP}"
                                PlaceholderText="Chọn loại"
                                SelectedItem="{Binding LoaiSP, Mode=TwoWay}"
                                Width="235" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" Margin="0,0,0,20">

                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Classes="label" Text="Số lượng" />
                            <Border
                                Background="{DynamicResource BgInput}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Height="41">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox
                                        Background="Transparent"
                                        BorderThickness="0"
                                        FontSize="15"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Grid.Column="0"
                                        Padding="12,10"
                                        Text="{Binding SoLuongSP, Mode=TwoWay}"
                                        VerticalContentAlignment="Center" />
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding IncreaseNumberOfProductCommand}"
                                        Content="▲"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="1"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />
                                    <Button
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DecreaseNumberOfProductCommand}"
                                        Content="▼"
                                        CornerRadius="0,8,8,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Grid.Column="2"
                                        Height="48"
                                        VerticalContentAlignment="Center"
                                        Width="35" />
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Classes="label" Text="Kích cỡ" />
                            <ComboBox
                                Classes="modern-combo"
                                HorizontalAlignment="Stretch"
                                ItemsSource="{Binding DanhSachKichThuocSP}"
                                PlaceholderText="FreeSize"
                                SelectedItem="{Binding KichThuocSP, Mode=TwoWay}"
                                Width="235" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Classes="label" Text="Thông tin sản phẩm" />
                        <TextBox
                            AcceptsReturn="True"
                            Classes="modern-input"
                            Height="140"
                            Text="{Binding MoTaSP, Mode=TwoWay}"
                            TextWrapping="Wrap"
                            VerticalContentAlignment="Top"
                            Watermark="Nhập mô tả chi tiết về sản phẩm..." />
                    </StackPanel>

                    <Button
                        Classes="primary"
                        Command="{Binding TaoSanPhamCommand}"
                        FontSize="16"
                        Height="52"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        ✓ Tạo sản phẩm
                    </Button>

                    <Button
                        Classes="secondary"
                        Command="{Binding $parent[Window].Close}"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Width="100">
                        Thoát
                    </Button>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>